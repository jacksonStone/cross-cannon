{
  "name": "cross-cannon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:browser && npm run build:server",
    "export:kindle": "npm run export:kindle:bible",
    "export:kindle:bible": "node --import tsx scripts/export-kindle-bible.ts",
    "export:kindle:first-clement": "node --import tsx scripts/export-kindle-first-clement.ts",
    "update-db:scripture-cache": "CROSS_CANNON_UPDATE_DB=1 node --import tsx scripts/build-scripture-cache.ts",
    "dev": "npm run build:browser && scripts/rust.sh run --locked -p r-cross-cannon",
    "start": "target/release/r-cross-cannon",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test scripts/lib/scripture-cache.test.ts scripts/lib/audio-alignment.test.ts scripts/export-kindle-bible.test.ts scripts/export-kindle-first-clement.test.ts scripts/rust-server-build.test.mjs scripts/browser-audio.test.mjs scripts/browser-precompression.test.mjs rust/api/src/accounts/assets/account.test.mjs && python3 scripts/test-classics-modernization.py && python3 scripts/test-classics-commentary.py && python3 scripts/test-server-release.py",
    "parse:church-fathers": "python3 scripts/parse-church-fathers.py",
    "build:church-fathers-preview": "python3 scripts/build-church-fathers-preview-assets.py",
    "build:church-fathers-audio-alignment": "node --import tsx scripts/build-church-fathers-audio-alignment.ts",
    "apply:church-fathers-modernization": "node --import tsx scripts/apply-church-fathers-modernization.ts",
    "modernize:church-fathers": "node --import tsx scripts/modernize-church-fathers.ts",
    "update-db:church-fathers-metadata": "node scripts/update-church-fathers-metadata.mjs",
    "index:church-fathers": "node --import tsx scripts/index-church-fathers.ts",
    "query:church-fathers": "node --import tsx scripts/query-church-fathers.ts",
    "verify": "scripts/verify.sh",
    "test:native-repaint": "bash scripts/test-native-repaint.sh",
    "verify:offline": "npm run build && E2E_MANAGE_SERVER=1 npm run verify:browser",
    "verify-prod": "scripts/verify-prod.sh",
    "ship": "CROSS_CANNON_UPDATE_DB=0 npm run verify && CROSS_CANNON_UPDATE_DB=0 ./deploy.sh && sleep 4 && npm run verify-prod",
    "index:bible": "node --import tsx scripts/index-bible.ts",
    "index:genesis": "node --import tsx scripts/index-bible.ts data/bible.json --reset --passage-type paragraph --book Genesis",
    "smoke:index": "EMBEDDING_PROVIDER=mock node --import tsx scripts/index-bible.ts data/sample-bible.json --reset --limit 10 --passage-type paragraph",
    "build:continuous-audio": "node --import tsx scripts/build-continuous-audio.ts",
    "verify:continuous-audio": "node --import tsx scripts/verify-continuous-audio.ts",
    "publish:christian-classics-modernization": "python3 scripts/publish-classics-modernization.py",
    "import:christian-classics": "python3 scripts/import-christian-classics.py",
    "index:christian-classics": "node --import tsx scripts/index-church-fathers.ts --input public/christian-classics-text/books.json --db storage/christian-classics.db --batch-size 256 --embedding-jobs 4",
    "update-db:accounts": "CROSS_CANNON_UPDATE_DB=1 scripts/rust.sh run --locked -p r-cross-cannon -- --init-accounts \"${ACCOUNTS_DATABASE_PATH:-storage/accounts.db}\"",
    "ship:docker": "python3 scripts/release-server.py --build-local && npm run verify-prod",
    "build:browser": "python3 scripts/build-browser.py",
    "verify:browser": "node scripts/e2e-rust-browser.mjs",
    "e2e:reader": "npm run verify:browser",
    "build:server": "scripts/rust.sh build --locked --release -p r-cross-cannon"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "puppeteer": "^24.43.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "@libsql/client": "^0.15.15",
    "openai": "^6.10.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
