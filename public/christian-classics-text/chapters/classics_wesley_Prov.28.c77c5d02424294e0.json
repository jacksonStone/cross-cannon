{"author":"John Wesley","book":"Notes on the Bible","chapter":915,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.28","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 28","reference":"Proverbs 28","notes":[],"verses":[{"verse":1,"text":"2.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":2,"text":"But - By a wise and good prince.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":3,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":4,"text":"It like - Is like a violent rain or flood, which washes away the very seeds in the earth.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":5,"text":"He is the worst of all oppressors.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"Contend - Are so far from praising them, that they severely reprove them.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"Judgment - What is just and right.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"All things - Which are necessary to be known by them.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"Better - In a much happier condition.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"10.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":14,"text":"Causeth - That by evil counsel, or example, or artifice, draws them into evil.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":15,"text":"12.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":16,"text":"Rejoice - Are promoted.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":17,"text":"Glory - In that common-wealth.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":18,"text":"Rise - Are advanced to authority.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":19,"text":"Hidden - Wise and good men, who only are worthy of the name of men, withdraw themselves into obscure places.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":20,"text":"14.","sourceParagraph":8,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":21,"text":"Alway - In all times, companies, and conditions.","sourceParagraph":8,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":22,"text":"16.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":23,"text":"Oppressor - The tyranny of a prince, is a manifest sign of folly.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":24,"text":"Prolong - By God's favour, the peace and satisfaction of his own mind, and the hearty love of his people.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":25,"text":"17.","sourceParagraph":10,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":26,"text":"Violence - That sheddeth any man's blood.","sourceParagraph":10,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":27,"text":"Shall flee - Shall speedily be destroyed.","sourceParagraph":10,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":28,"text":"Shall slay - None should desire or endeavour to save him from his deserved punishment.","sourceParagraph":10,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":29,"text":"18.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":30,"text":"At once - Once for all; so he shall never rise more.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":31,"text":"20.","sourceParagraph":12,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":32,"text":"Faithful - Who deals truly and justly in all his transactions.","sourceParagraph":12,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":33,"text":"21.","sourceParagraph":13,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":34,"text":"For - When a man hath once accustomed himself to take bribes, a very small advantage will make him sell justice.","sourceParagraph":13,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":35,"text":"22.","sourceParagraph":14,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":36,"text":"Evil eye - Is uncharitable to persons in want, and envious to those who get any thing besides him.","sourceParagraph":14,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":37,"text":"Poverty - And consequently that he shall need the pity and help of others.","sourceParagraph":14,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":38,"text":"24.","sourceParagraph":15,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":39,"text":"The same - Is a thief and robber.","sourceParagraph":15,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":40,"text":"25.","sourceParagraph":16,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":41,"text":"Fat - Shall live happily and comfortably.","sourceParagraph":16,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":42,"text":"26.","sourceParagraph":17,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":43,"text":"Wisely - Distrusting his own judgment, and seeking the advice of others, and especially of God.","sourceParagraph":17,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":44,"text":"28.","sourceParagraph":18,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":45,"text":"Men - Righteous men are afraid to appear publickly.","sourceParagraph":18,"scriptureVerseStart":28,"scriptureVerseEnd":28}],"scriptureReference":{"book":"Proverbs","chapter":28}}