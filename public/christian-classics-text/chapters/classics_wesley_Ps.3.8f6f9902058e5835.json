{"author":"John Wesley","book":"Notes on the Bible","chapter":740,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.3","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 3","reference":"Psalms 3","notes":[],"verses":[{"verse":1,"text":"David complains to God of his enemies, ver.","sourceParagraph":1},{"verse":2,"text":"1, 2.","sourceParagraph":1},{"verse":3,"text":"Comforts himself in God, and the experience of his goodness, ver.","sourceParagraph":1},{"verse":4,"text":"3-6.","sourceParagraph":1},{"verse":5,"text":"Triumphs in the salvation of God, ver.","sourceParagraph":1},{"verse":6,"text":"7, 8 A psalm of David, when he fled from Absalom his son.","sourceParagraph":1},{"verse":7,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"My soul - Of me: the soul being commonly put for the person.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"In God - God hath utterly forsaken him.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"Selah - This word is no where used but in this poetical book, and in the song of Habakkuk.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":11,"text":"Probably it was a musical note, directing the singer either to lift up his voice, to make a pause, or to lengthen the tune.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"But withal, it is generally placed at some remarkable passage; which gives occasion to think that it served also to quicken the attention of the singer and hearer.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":14,"text":"A shield - My defense.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":15,"text":"My glory - Thou hast formerly given, and wilt farther give occasion of glorying in thy power and favour.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":16,"text":"Lifter up - Thou wilt restore me to my former power and dignity.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":17,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":18,"text":"His hill - Out of heaven, so called, chap. xv, 1.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":19,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":20,"text":"Slept - Securely, casting all my cares upon God.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":21,"text":"Awaked - After a sweet and undisturbed sleep.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":22,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":23,"text":"Cheek bone - Which implies contempt and reproach.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":24,"text":"Teeth - Their strength and the instruments of their cruelty.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":25,"text":"He compares them to wild beasts.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Psalms","chapter":3}}