{"author":"John Wesley","book":"Notes on the Bible","chapter":882,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.145","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 145","reference":"Psalms 145","notes":[],"verses":[{"verse":1,"text":"This also is an alphabetical psalm.","sourceParagraph":1},{"verse":2,"text":"In it David praises God for his greatness, ver.","sourceParagraph":1},{"verse":3,"text":"1-7.","sourceParagraph":1},{"verse":4,"text":"For his goodness and everlasting kingdom, ver.","sourceParagraph":1},{"verse":5,"text":"8-13.","sourceParagraph":1},{"verse":6,"text":"For his providence, ver.","sourceParagraph":1},{"verse":7,"text":"14-16.","sourceParagraph":1},{"verse":8,"text":"For his mercy to his servants, ver.","sourceParagraph":1},{"verse":9,"text":"17-21.","sourceParagraph":1},{"verse":10,"text":"David's psalm of praise.","sourceParagraph":1},{"verse":11,"text":"14.","sourceParagraph":2,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":12,"text":"All - All that look up to him for help.","sourceParagraph":2,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":13,"text":"15.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":14,"text":"All - Of all living creatures.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":15,"text":"Wait - Expect their supplies wholly from thy bounty.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":16,"text":"Expectation is here figuratively ascribed to brute creatures.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":17,"text":"18.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":18,"text":"Nigh - To answer their prayers.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":19,"text":"In truth - With an upright heart.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18}],"scriptureReference":{"book":"Psalms","chapter":145}}