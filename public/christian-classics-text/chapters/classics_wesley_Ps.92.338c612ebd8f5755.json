{"author":"John Wesley","book":"Notes on the Bible","chapter":829,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.92","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 92","reference":"Psalms 92","notes":[],"verses":[{"verse":1,"text":"God is praised for his works, ver."},{"verse":2,"text":"1-5."},{"verse":3,"text":"The doom of the wicked, from the eternal God, ver."},{"verse":4,"text":"6-9."},{"verse":5,"text":"The prosperity of the righteous, ver."},{"verse":6,"text":"10-15."},{"verse":7,"text":"A psalm or song for the sabbath-day."},{"verse":8,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"Thoughts - Thy counsels in the government of the world and of thy church.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"A brutish man - Who is led by sense, not by reason and faith.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"This - The depth of God's counsels and works.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"10.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":14,"text":"Anointed - I shall have cause of testifying my joy by anointing myself, as the manner was at all joyful solemnities.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":15,"text":"12.","scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":16,"text":"Palm-tree - Which is constantly green and flourishing.","scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":17,"text":"13.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":18,"text":"Planted - Whom God by his gracious providence has fixed there.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":19,"text":"The house - In its courts; he means in the church of God, whereof all good men are living members.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":20,"text":"14.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":21,"text":"Old age - Their last days shall be their best days, wherein they shall grow in grace, and increase in blessedness.","scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Psalms","chapter":92}}