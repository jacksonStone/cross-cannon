{"author":"John Wesley","book":"Notes on the Bible","chapter":1168,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Zeph.3","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Zephaniah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Zephaniah 3","reference":"Zephaniah 3","notes":[],"verses":[{"verse":1,"text":"Jerusalem threatened for her wickedness, ver.","sourceParagraph":1},{"verse":2,"text":"1-7.","sourceParagraph":1},{"verse":3,"text":"A promise of a glorious reformation, ver.","sourceParagraph":1},{"verse":4,"text":"8-13.","sourceParagraph":1},{"verse":5,"text":"And deliverance consequent upon it, ver.","sourceParagraph":1},{"verse":6,"text":"14-20.","sourceParagraph":1},{"verse":7,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"To her - Jerusalem.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"The voice - Of God by his mercy and judgments crying aloud.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":11,"text":"3.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":12,"text":"Her princes - Persons of principal place and authority.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":13,"text":"Lions - Which hunt for prey, and are ever affrighting or devouring.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":14,"text":"Wolves - Insatiable and cruel, like wolves of the evening, whetted with hunger.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":15,"text":"Gnaw not the bones - They leave nothing but the bones to be eaten on the morrow.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":16,"text":"4.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":17,"text":"Her prophet - So called, false prophets.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":18,"text":"Light - Unstable and inconstant.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":19,"text":"Violence to the law - Wresting it by perverse interpretation.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":20,"text":"5.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":21,"text":"In the midst - Observing all.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":22,"text":"Not do iniquity - He will judge them righteously.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":23,"text":"Every morning - Daily he discovers his displeasure against the wicked.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":24,"text":"Faileth not - Lets no season slip to convince them, by public and visible punishments.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":25,"text":"The unjust - But the wicked Jews proceed without shame, and without fear.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":26,"text":"6.","sourceParagraph":7,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":27,"text":"The nations - Of old, the Canaanites, lastly the ten tribes, and later yet, the Assyrians.","sourceParagraph":7,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":28,"text":"7.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":29,"text":"I said - I thought (speaking after the manner of men).","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":30,"text":"Thou - O Jerusalem.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":31,"text":"Fear me - For the many and great judgments executed upon others.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":32,"text":"I punished them - In some measure.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":33,"text":"8.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":34,"text":"Therefore - Since you will not be amended.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":35,"text":"Wait ye - Attend my resolution.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":36,"text":"Until - Until I rise up to destroy first, and next to take the spoil.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":37,"text":"Upon them - The incorrigible Jews.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":38,"text":"Devoured - Consumed as if burnt up.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":39,"text":"My jealousy - That jealousy wherewith God is jealous for his own glory.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":40,"text":"9.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":41,"text":"A pure language - I will give them a pure way of worshipping me, the issue of a pure heart.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":42,"text":"10.","sourceParagraph":11,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":43,"text":"My dispersed - The praying remnant of the scattered Jews shall return to their own land, and bring themselves an offering unto the Lord.","sourceParagraph":11,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":44,"text":"11.","sourceParagraph":12,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":45,"text":"Thy doings - Thy sins formerly committed.","sourceParagraph":12,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":46,"text":"In thy pride - Proud formalists.","sourceParagraph":12,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":47,"text":"No more be haughty - Ye shall no more boast, because of the city, or the temple.","sourceParagraph":12,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":48,"text":"12.","sourceParagraph":13,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":49,"text":"Of thee - In Judea and Jerusalem.","sourceParagraph":13,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":50,"text":"13.","sourceParagraph":14,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":51,"text":"Shall feed - Shall enjoy peace and plenty.","sourceParagraph":14,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":52,"text":"15.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":53,"text":"Taken away - Abolished, and put an end to the judgments thy sins brought upon thee.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":54,"text":"Thine enemy - The Babylonian.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":55,"text":"Is in the midst - He is returned to redeem and govern thee.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":56,"text":"Any more - While thy carriage is as becomes my presence with thee, thou shalt neither fear, nor feel the like evils.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":57,"text":"18.","sourceParagraph":16,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":58,"text":"Sorrowful - That mourn their distance from the solemn worship of God.","sourceParagraph":16,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":59,"text":"Who are of thee - Thy children.","sourceParagraph":16,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":60,"text":"Reproach - The taunts of their enemies.","sourceParagraph":16,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":61,"text":"19.","sourceParagraph":17,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":62,"text":"Undo - I will break their power and dissolve their kingdom.","sourceParagraph":17,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":63,"text":"That halteth - Who is in trouble and ready to fall.","sourceParagraph":17,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":64,"text":"Driven out - Into remote countries.","sourceParagraph":17,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":65,"text":"20.","sourceParagraph":18,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":66,"text":"A praise - So the universal church of the first-born will be, in the great day.","sourceParagraph":18,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":67,"text":"And then the Israel of God be made a name and a praise to all eternity.","sourceParagraph":18,"scriptureVerseStart":20,"scriptureVerseEnd":20}],"scriptureReference":{"book":"Zephaniah","chapter":3}}