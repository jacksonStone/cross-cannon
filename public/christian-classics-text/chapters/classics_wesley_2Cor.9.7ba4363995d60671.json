{"author":"John Wesley","book":"Notes on the Bible","chapter":158,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:2Cor.9","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"2 Corinthians","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"2 Corinthians 9","reference":"2 Corinthians 9","notes":[],"verses":[{"verse":1,"text":"1.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"To write to you - Largely.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":4,"text":"I boast to them of Macedonia - With whom he then was.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"I have sent the above mentioned brethren before me.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"Spoken of before - By me, to the Macedonians.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"Not as a matter of covetousness - As wrung by importunity from covetous persons.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"He that soweth sparingly shall reap sparingly; he that soweth bountifully shall reap bountifully - A general rule.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"God will proportion the reward to the work, and the temper whence it proceeds.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"Of necessity - Because he cannot tell how to refuse.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"8.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"How remarkable are these words!","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"Each is loaded with matter and increases all the way it goes.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"All grace - Every kind of blessing.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":19,"text":"That ye may abound to every good work - God gives us everything, that we may do good therewith, and so receive more blessings.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":20,"text":"All things in this life, even rewards, are, to the faithful, seeds in order to a future harvest.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":21,"text":"Prov. xxii, 9","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"9.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"He hath scattered abroad - (A generous word.)","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":24,"text":"With a full hand, without any anxious thought which way each grain falls.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":25,"text":"His righteousness - His beneficence, with the blessed effects of it.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":26,"text":"Remaineth forever - Unexhausted, God still renewing his store.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":27,"text":"Psalm cxii, 9","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":28,"text":"10.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":29,"text":"And he who supplieth seed - Opportunity and ability to help others.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":30,"text":"And bread - All things needful for your own souls and bodies.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":31,"text":"Will continually supply you with that seed, yea, multiply it to you more and more.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":32,"text":"And increase the fruits of your righteousness - The happy effects of your love to God and man.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":33,"text":"Isaiah lv, 10","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":34,"text":"11.","sourceParagraph":10,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":35,"text":"Which worketh by us thanksgiving to God - Both from us who distribute, and them who receive, your bounty.","sourceParagraph":10,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":36,"text":"13.","sourceParagraph":11,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":37,"text":"Your avowed subjection - Openly testified by your actions.","sourceParagraph":11,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":38,"text":"To all men - Who stand in need of it.","sourceParagraph":11,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":39,"text":"15.","sourceParagraph":12,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":40,"text":"His unspeakable gift - His outward and inward blessings, the number and excellence of which cannot be uttered.","sourceParagraph":12,"scriptureVerseStart":15,"scriptureVerseEnd":15}],"scriptureReference":{"book":"2 Corinthians","chapter":9}}