{"author":"John Wesley","book":"Notes on the Bible","chapter":871,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.134","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 134","reference":"Psalms 134","notes":[],"verses":[{"verse":1,"text":"In this Psalm the priests or Levites who watched all night in the temple, exhort one another, and pray for one another, ver."},{"verse":2,"text":"1-3."},{"verse":3,"text":"A song of degrees."},{"verse":4,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"Servant - Peculiarly so called, priests and Levites.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"Night - Not only by day, but also by night, when their watch was more necessary.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Stand - Serve or minister.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Thee - Thee whosoever thou art who dost faithfully perform the duty here commanded.","scriptureVerseStart":3,"scriptureVerseEnd":3}],"scriptureReference":{"book":"Psalms","chapter":134}}