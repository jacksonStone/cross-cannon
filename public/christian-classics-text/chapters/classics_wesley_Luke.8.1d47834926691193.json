{"author":"John Wesley","book":"Notes on the Bible","chapter":52,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Luke.8","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Luke","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Luke 8","reference":"Luke 8","notes":[],"verses":[{"verse":1,"text":"2.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":2,"text":"Mary Magdalene - Or Mary of Magdala, a town in Galilee: probably the person mentioned in the last chapter.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":3,"text":"4.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":4,"text":"Matt. xiii, 1; Mark iv, 1.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":5,"text":"15.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":6,"text":"Who - keep it - Not like the highway side: And bring forth fruit - Not like the thorny ground: With perseverance - Not like the stony.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":7,"text":"16.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":8,"text":"No man having lighted a candle - As if he had said, And let your good fruit appear openly.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":9,"text":"Matt. v, 15; Mark iv, 21; Chap. xi, 33.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":10,"text":"17.","sourceParagraph":5,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":11,"text":"For nothing is hid - Strive not to conceal it at all; for you can conceal nothing long.","sourceParagraph":5,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":12,"text":"Matt. x, 26; Mark iv, 22; Chap. xii, 2.","sourceParagraph":5,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":13,"text":"18.","sourceParagraph":6,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":14,"text":"The word commonly translated seemeth, wherever it occurs, does not weaken, but greatly strengthens the sense.","sourceParagraph":6,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":15,"text":"Matt. xiii, 12; Mark iv, 25; Luke xix, 26.","sourceParagraph":6,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":16,"text":"19.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":17,"text":"Matt. xii, 46; Mark iii, 31.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":18,"text":"22.","sourceParagraph":8,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":19,"text":"Matt. viii, 23; Mark iv, 35.","sourceParagraph":8,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":20,"text":"26.","sourceParagraph":9,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":21,"text":"Matt. viii, 28; Mark v, 1.","sourceParagraph":9,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":22,"text":"29.","sourceParagraph":10,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":23,"text":"For many times it had caught him - Therefore our compassionate Lord made the more haste to cast him out.","sourceParagraph":10,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":24,"text":"31.","sourceParagraph":11,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":25,"text":"The abyss - That is, the bottomless pit.","sourceParagraph":11,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":26,"text":"32.","sourceParagraph":12,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":27,"text":"To enter into the swine - Not that they were any easier in the swine than out of them.","sourceParagraph":12,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":28,"text":"Had it been so, they would not so soon have dislodged themselves, by destroying the herd.","sourceParagraph":12,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":29,"text":"37.","sourceParagraph":13,"scriptureVerseStart":37,"scriptureVerseEnd":37},{"verse":30,"text":"Matt. ix, 1; Mark v, 18.","sourceParagraph":13,"scriptureVerseStart":37,"scriptureVerseEnd":37},{"verse":31,"text":"40.","sourceParagraph":14,"scriptureVerseStart":40,"scriptureVerseEnd":40},{"verse":32,"text":"Mark v, 21.","sourceParagraph":14,"scriptureVerseStart":40,"scriptureVerseEnd":40},{"verse":33,"text":"52.","sourceParagraph":15,"scriptureVerseStart":52,"scriptureVerseEnd":52},{"verse":34,"text":"She is not dead but sleepeth - Her soul is not separated finally from the body; and this short separation is rather to be called sleep than death.","sourceParagraph":15,"scriptureVerseStart":52,"scriptureVerseEnd":52}],"scriptureReference":{"book":"Luke","chapter":8}}