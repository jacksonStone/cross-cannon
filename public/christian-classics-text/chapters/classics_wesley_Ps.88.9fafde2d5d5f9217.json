{"author":"John Wesley","book":"Notes on the Bible","chapter":825,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.88","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 88","reference":"Psalms 88","notes":[],"verses":[{"verse":1,"text":"This is the most melancholy of all the Psalms: it is all lamentation, and mourning, and woe.","sourceParagraph":1},{"verse":2,"text":"Here we have the pressure of spirit which the psalmist was under, ver.","sourceParagraph":1},{"verse":3,"text":"1-9.","sourceParagraph":1},{"verse":4,"text":"His humble pleadings with God, ver.","sourceParagraph":1},{"verse":5,"text":"10-14.","sourceParagraph":1},{"verse":6,"text":"A farther declaration of his affliction, ver.","sourceParagraph":1},{"verse":7,"text":"15-18.","sourceParagraph":1},{"verse":8,"text":"A song or psalm for the sons of Korah, to the chief musician upon Mahalath Leannoth, Maschil of Heman the Ezrahite.","sourceParagraph":1},{"verse":9,"text":"Title of the psalm.","sourceParagraph":1},{"verse":10,"text":"Leannoth - Which seems to be the name of the instrument.","sourceParagraph":1},{"verse":11,"text":"Heman - Probably the same person who was famous in David's time, both for his skill in musick, and for wisdom.","sourceParagraph":1},{"verse":12,"text":"4.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"Counted - l am given up by my friends for a lost man.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"Free - Well nigh discharged from the warfare of the present life, and entered as a member into the society of the dead.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":16,"text":"Whom - Thou seemest to neglect and bury in oblivion.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":17,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"Waves - With they judgments, breaking in furiously upon me like the waves of the sea.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":19,"text":"10.","sourceParagraph":5,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":20,"text":"Wonders - In raising them to life.","sourceParagraph":5,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":21,"text":"To praise thee - In this world?","sourceParagraph":5,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":22,"text":"12.","sourceParagraph":6,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":23,"text":"Forgetfulness - In the grave, where men are forgotten by their nearest relations.","sourceParagraph":6,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":24,"text":"13.","sourceParagraph":7,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":25,"text":"Prevent - Come to thee before the dawning of the day, or the rising of the sun.","sourceParagraph":7,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":26,"text":"17.","sourceParagraph":8,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":27,"text":"Water - As the waters of the sea encompass him who is in the midst of it.","sourceParagraph":8,"scriptureVerseStart":17,"scriptureVerseEnd":17}],"scriptureReference":{"book":"Psalms","chapter":88}}