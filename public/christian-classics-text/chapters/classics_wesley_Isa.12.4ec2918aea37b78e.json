{"author":"John Wesley","book":"Notes on the Bible","chapter":950,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Isa.12","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Isaiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Isaiah 12","reference":"Isaiah 12","notes":[],"verses":[{"verse":1,"text":"A thanksgiving of the faithful for their redemption, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"In that day - When this great work of the reduction of Israel, and conversion of the Gentiles is fulfilled.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"God - My salvation hath not been brought to pass by man, but by the almighty power of God.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"3.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"With joy - Your thirsty souls shall be filled with Divine graces and comforts, which you may draw from God, in the use of gospel-ordinances.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3}],"scriptureReference":{"book":"Isaiah","chapter":12}}