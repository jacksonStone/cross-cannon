{"author":"John Wesley","book":"Notes on the Bible","chapter":833,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.96","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 96","reference":"Psalms 96","notes":[],"verses":[{"verse":1,"text":"This psalm is a part of that which was delivered to Asaph and his brethren, 1 Chron. xvi, 7, on occasion of bringing up the ark to the city of David."},{"verse":2,"text":"Here is a call to praise God, as a great and glorious God, ver."},{"verse":3,"text":"1-9."},{"verse":4,"text":"To rejoice in his judging all the world, ver."},{"verse":5,"text":"10-13."},{"verse":6,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"O sing - Upon this new and great occasion, not the removal of the ark, but the coming of the Messiah.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"Gods - The gods of the nations, as the next verse expounds it.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"Before him - In his presence.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"9.","scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":13,"text":"Beauty - Cloathed with all the gifts and graces, which are necessary in God's worship.","scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":14,"text":"10.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":15,"text":"Reigneth - God hath now set up his kingdom in the world.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":16,"text":"Established - The nations of the world shall by the means of it enjoy an established and lasting peace.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":17,"text":"13.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":18,"text":"Before - At the presence and approach of their Lord and Maker.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":19,"text":"Cometh - To set up his throne among all the nations of the earth.","scriptureVerseStart":13,"scriptureVerseEnd":13}],"scriptureReference":{"book":"Psalms","chapter":96}}