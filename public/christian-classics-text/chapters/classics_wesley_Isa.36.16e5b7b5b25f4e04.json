{"author":"John Wesley","book":"Notes on the Bible","chapter":974,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Isa.36","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Isaiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Isaiah 36","reference":"Isaiah 36","notes":[],"verses":[{"verse":1,"text":"Sennacherib invades Judah, ver.","sourceParagraph":1},{"verse":2,"text":"1.","sourceParagraph":1},{"verse":3,"text":"He sends Rabshakeh, who by his blasphemous persuasions tempts Hezekiah to despair, and the people to revolt, ver.","sourceParagraph":1},{"verse":4,"text":"2-22.","sourceParagraph":1},{"verse":5,"text":"The history related here, and in the three following chapters, is, almost in the same words contained 2 Kings 18, 19, 20.","sourceParagraph":1},{"verse":6,"text":"It is inserted here, to explain and confirm some of the foregoing predictions.","sourceParagraph":1},{"verse":7,"text":"It may seem to have first been written by this prophet, and from him taken into the book of Kings, to compleat that history.","sourceParagraph":1}],"scriptureReference":{"book":"Isaiah","chapter":36}}