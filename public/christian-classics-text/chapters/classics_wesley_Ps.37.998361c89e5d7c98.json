{"author":"John Wesley","book":"Notes on the Bible","chapter":774,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.37","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 37","reference":"Psalms 37","notes":[],"verses":[{"verse":1,"text":"David exhorts to patience and confidence in God, ver.","sourceParagraph":1},{"verse":2,"text":"1-8.","sourceParagraph":1},{"verse":3,"text":"Shews the different state of the righteous and the wicked, ver.","sourceParagraph":1},{"verse":4,"text":"9- 40.","sourceParagraph":1},{"verse":5,"text":"A psalm of David.","sourceParagraph":1},{"verse":6,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Fret not - Because they prosper in their wicked enterprizes.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"Commit - All thy cares and business, and necessities, commend to God by fervent prayer.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"Judgment - It shall be as visible to men, as the light of the sun, at noon-day.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"Rest - Do not repine at his dealings, but quietly submit to his will, and wait for his help.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":15,"text":"Fret not - Either against the sinner for his success; or against God.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"Do evil - If grief arise in thee, take care that it do not transport thee to sin.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"9.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":18,"text":"The earth - This for the most part was literally fulfilled in that state of the church.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":19,"text":"10.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":20,"text":"Not be - He shall be dead and gone.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":21,"text":"Diligently - Industriously seeking him.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":22,"text":"His place - His place and estate, and glory.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":23,"text":"11.","sourceParagraph":9,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":24,"text":"But - Those who patiently bear God's afflicting hand, and meekly pass by injuries.","sourceParagraph":9,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":25,"text":"Peace - Partly of outward peace and prosperity, which God in his due time will give them: but principally of inward peace, in the sense of God's favour and the assurance of endless happiness.","sourceParagraph":9,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":26,"text":"13.","sourceParagraph":10,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":27,"text":"His day - The day appointed by God for his punishment or destruction.","sourceParagraph":10,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":28,"text":"18.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":29,"text":"Knoweth - Observes with care and affection.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":30,"text":"The days - All things which befall them, their dangers and fears, and suffering.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":31,"text":"For ever - To them and their seed forever: and when they die their inheritance is not lost, but exchanged for one infinitely better.","sourceParagraph":11,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":32,"text":"20.","sourceParagraph":12,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":33,"text":"Fat - Which in an instant melts before the fire.","sourceParagraph":12,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":34,"text":"23.","sourceParagraph":13,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":35,"text":"Established - So that he shall not fall into mischief.","sourceParagraph":13,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":36,"text":"24.","sourceParagraph":14,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":37,"text":"Fall - Into trouble.","sourceParagraph":14,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":38,"text":"25.","sourceParagraph":15,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":39,"text":"Forsaken - These temporal promises, were more express to the Jews in the times of the Old Testament, than to Christians.","sourceParagraph":15,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":40,"text":"26.","sourceParagraph":16,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":41,"text":"Blessed - Not only with spiritual, but with temporal blessings.","sourceParagraph":16,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":42,"text":"27.","sourceParagraph":17,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":43,"text":"Dwell - Thou shalt dwell in the land, and afterwards in heaven.","sourceParagraph":17,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":44,"text":"30.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":45,"text":"The mouth - Having shewed, God's singular care over the righteous, he proceeds to give a character of them.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":46,"text":"Judgment - Of God's judgment, word or law.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":47,"text":"31.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":48,"text":"Heart - His thoughts, meditations and affections are fixed upon it.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":49,"text":"Slide - Slide, or swerve, from the rule, from God's law.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":50,"text":"35.","sourceParagraph":20,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":51,"text":"Bay-tree - Which is continually green and flourishing even in winter.","sourceParagraph":20,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":52,"text":"36.","sourceParagraph":21,"scriptureVerseStart":36,"scriptureVerseEnd":36},{"verse":53,"text":"Yet - He was gone in an instant.","sourceParagraph":21,"scriptureVerseStart":36,"scriptureVerseEnd":36},{"verse":54,"text":"But - There was no monument or remainder of him left.","sourceParagraph":21,"scriptureVerseStart":36,"scriptureVerseEnd":36},{"verse":55,"text":"37.","sourceParagraph":22,"scriptureVerseStart":37,"scriptureVerseEnd":37},{"verse":56,"text":"Peace - Though he may meet with troubles in his way, yet all shall end well.","sourceParagraph":22,"scriptureVerseStart":37,"scriptureVerseEnd":37},{"verse":57,"text":"38.","sourceParagraph":23,"scriptureVerseStart":38,"scriptureVerseEnd":38},{"verse":58,"text":"Together - All without exception.","sourceParagraph":23,"scriptureVerseStart":38,"scriptureVerseEnd":38}],"scriptureReference":{"book":"Psalms","chapter":37}}