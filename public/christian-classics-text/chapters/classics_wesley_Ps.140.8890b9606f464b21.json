{"author":"John Wesley","book":"Notes on the Bible","chapter":877,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.140","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 140","reference":"Psalms 140","notes":[],"verses":[{"verse":1,"text":"David prays and hopes for deliverance from his enemies, ver."},{"verse":2,"text":"1-7."},{"verse":3,"text":"Foretells their destruction, ver."},{"verse":4,"text":"8-13."},{"verse":5,"text":"To the chief musician, A psalm of David."},{"verse":6,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"Tongues - Using words as sharp and piercing as the sting of a serpent.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"9.","scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":9,"text":"Mischief - The mischief which they design against me, shall fall upon themselves.","scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":10,"text":"10.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":11,"text":"Coals - Divine vengeance, which is compared to coals of fire.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":12,"text":"13.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":13,"text":"Dwell - Shall constantly enjoy thy gracious and powerful presence.","scriptureVerseStart":13,"scriptureVerseEnd":13}],"scriptureReference":{"book":"Psalms","chapter":140}}