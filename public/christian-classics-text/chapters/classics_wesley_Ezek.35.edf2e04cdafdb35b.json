{"author":"John Wesley","book":"Notes on the Bible","chapter":1096,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ezek.35","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Ezekiel","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Ezekiel 35","reference":"Ezekiel 35","notes":[],"verses":[{"verse":1,"text":"A prophecy against Edom for their hatred to Israel, ver.","sourceParagraph":1},{"verse":2,"text":"1- 13.","sourceParagraph":1},{"verse":3,"text":"Their ruin shall be perpetual, ver.","sourceParagraph":1},{"verse":4,"text":"14, 15.","sourceParagraph":1},{"verse":5,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"Mount Seir - The Edomites, who inhabited it.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"Their iniquity - When their iniquity was punished on them, which brought them to final ruin.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":10,"text":"And blood - Thy guilt, and my just revenge of innocent blood.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"Hast not hated - Thou hast loved, rather than hated, blood-shed; therefore vengeance for it follows thee.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"That passeth out - All travelers that go to or from Edom.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"9.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":15,"text":"Return - To their former glory.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":16,"text":"10.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":17,"text":"Though - Though God was with Israel.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":18,"text":"11.","sourceParagraph":8,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":19,"text":"Judged - Punished thee.","sourceParagraph":8,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":20,"text":"14.","sourceParagraph":9,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":21,"text":"The whole earth - The inhabitants of all the countries round about thee.","sourceParagraph":9,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":22,"text":"Rejoiceth - Is in peace and plenty.","sourceParagraph":9,"scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Ezekiel","chapter":35}}