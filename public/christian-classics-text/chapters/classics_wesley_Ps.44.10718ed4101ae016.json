{"author":"John Wesley","book":"Notes on the Bible","chapter":781,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.44","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 44","reference":"Psalms 44","notes":[],"verses":[{"verse":1,"text":"The church commemorates past mercies, ver."},{"verse":2,"text":"1-8."},{"verse":3,"text":"Complains of present troubles, ver."},{"verse":4,"text":"9-16."},{"verse":5,"text":"Professes her integrity, ver."},{"verse":6,"text":"17-22."},{"verse":7,"text":"Prays for succor, ver."},{"verse":8,"text":"23-26."},{"verse":9,"text":"To the chief musician for the sons of Korah, Maschil."},{"verse":10,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"My king - The whole people speak as one man, being united in one body.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"11.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":13,"text":"Scattered - Those who were not slain are carried into captivity, and dispersed in several places.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":14,"text":"16.","scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":15,"text":"Avenger - Who executeth both God's and his own vengeance upon me.","scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":16,"text":"17.","scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":17,"text":"Yet - Although we cannot excuse ourselves from many other sins, yet through thy grace we have kept ourselves from apostacy and idolatry, notwithstanding all examples and provocations.","scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":18,"text":"18.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":19,"text":"Turned - From thy worship to idols.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":20,"text":"19.","scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":21,"text":"Broken us - By inflicting upon us one breach after another, thou hast at last brought us to this pass.","scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":22,"text":"The place - A place extremely desolate, such as dragons love, Isaiah xiii, 21, 22, and therefore full of horror, and danger.","scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":23,"text":"Covered us - With deadly horrors and miseries.","scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":24,"text":"22.","scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":25,"text":"Yea - Because we are constant in thy worship, which they abhor.","scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":26,"text":"25.","scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":27,"text":"Our soul - Our persons.","scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":28,"text":"Our belly - We are not only thrown down to the earth, but we lie there like dead carcases.","scriptureVerseStart":25,"scriptureVerseEnd":25}],"scriptureReference":{"book":"Psalms","chapter":44}}