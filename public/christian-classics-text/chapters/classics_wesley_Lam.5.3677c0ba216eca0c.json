{"author":"John Wesley","book":"Notes on the Bible","chapter":1061,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Lam.5","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Lamentations","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Lamentations 5","reference":"Lamentations 5","notes":[],"verses":[{"verse":1,"text":"An humble prayer, presenting to the Lord their great misery, ver.","sourceParagraph":1},{"verse":2,"text":"1-15.","sourceParagraph":1},{"verse":3,"text":"Confessing their sins, ver.","sourceParagraph":1},{"verse":4,"text":"16-18.","sourceParagraph":1},{"verse":5,"text":"Imploring deliverance, ver.","sourceParagraph":1},{"verse":6,"text":"19-22.","sourceParagraph":1},{"verse":7,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"We - We are all of us without a king, (our common father) we are deprived of thy fatherly protection, and many young children among us are left without an earthly parent.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"Sold - Whereas at other times there was abundance of wood and water throughout Judea.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"We - The ten tribes were all carried captives into Assyria, and many of the kingdom of Judah fled into Egypt.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"Giving the hand may signify labouring for them: or, yielding up themselves to their power.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"Their iniquities - The punishment of them.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":16,"text":"9.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":17,"text":"The sword - The enemies lay encamped in all the plains, so that they could stir out no way but the sword of the Chaldeans was upon them.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":18,"text":"13.","sourceParagraph":7,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":19,"text":"Fell - Not being able to stand under the burdens laid upon them.","sourceParagraph":7,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":20,"text":"16.","sourceParagraph":8,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":21,"text":"The crown - All our honour, splendour and dignity.","sourceParagraph":8,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":22,"text":"19.","sourceParagraph":9,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":23,"text":"Thy throne - Altho' for our sins thou sufferest our throne to be cast down, yet thou art the same, thy power is not diminished, nor thy goodness abated.","sourceParagraph":9,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":24,"text":"21.","sourceParagraph":10,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":25,"text":"Renew - Restore us to our former estate.","sourceParagraph":10,"scriptureVerseStart":21,"scriptureVerseEnd":21}],"scriptureReference":{"book":"Lamentations","chapter":5}}