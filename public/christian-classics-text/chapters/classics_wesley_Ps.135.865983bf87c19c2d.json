{"author":"John Wesley","book":"Notes on the Bible","chapter":872,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.135","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 135","reference":"Psalms 135","notes":[],"verses":[{"verse":1,"text":"An exhortation to praise God for his greatness and mighty works, ver.","sourceParagraph":1},{"verse":2,"text":"1-7.","sourceParagraph":1},{"verse":3,"text":"For destroying his enemies, ver.","sourceParagraph":1},{"verse":4,"text":"8-11.","sourceParagraph":1},{"verse":5,"text":"For his mercy toward Israel, ver.","sourceParagraph":1},{"verse":6,"text":"12-14.","sourceParagraph":1},{"verse":7,"text":"The vanity of idols, ver.","sourceParagraph":1},{"verse":8,"text":"15-18.","sourceParagraph":1},{"verse":9,"text":"Another exhortation to praise God, ver.","sourceParagraph":1},{"verse":10,"text":"19-20.","sourceParagraph":1},{"verse":11,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"Ye - Ye priest and Levites.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"6.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"Seas - In the visible seas, and in the invisible depths both of the earth and of the waters.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":16,"text":"From - From all parts of the earth, from one end to another.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":17,"text":"Rain - An eminent instance of his good providence.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"14.","sourceParagraph":5,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":19,"text":"Judge - Will in due time plead the cause of his people.","sourceParagraph":5,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":20,"text":"Repent - He will recall that severe sentence which for their sins he had passed upon them.","sourceParagraph":5,"scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Psalms","chapter":135}}