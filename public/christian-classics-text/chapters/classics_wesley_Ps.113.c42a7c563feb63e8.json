{"author":"John Wesley","book":"Notes on the Bible","chapter":850,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.113","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 113","reference":"Psalms 113","notes":[],"verses":[{"verse":1,"text":"We are here exhorted to praise God, ver.","sourceParagraph":1},{"verse":2,"text":"1-3.","sourceParagraph":1},{"verse":3,"text":"Particularly for his glory and greatness, ver.","sourceParagraph":1},{"verse":4,"text":"4, 5 And for his grace and goodness, ver.","sourceParagraph":1},{"verse":5,"text":"6-9.","sourceParagraph":1},{"verse":6,"text":"6.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":7,"text":"Humbleth - Who is so high, that it is a wonderful condescention in him to take any notice of his heavenly host, and much more of sinful and miserable men upon earth.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":8,"text":"8.","sourceParagraph":3,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":9,"text":"Princes - As he did Joseph, David, and others.","sourceParagraph":3,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":10,"text":"His people - Who in God's account are far more honourable than the princes of Heathen nations.","sourceParagraph":3,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":113}}