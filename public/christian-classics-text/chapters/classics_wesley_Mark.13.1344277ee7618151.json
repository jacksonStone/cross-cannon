{"author":"John Wesley","book":"Notes on the Bible","chapter":41,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Mark.13","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Mark","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Mark 13","reference":"Mark 13","notes":[],"verses":[{"verse":1,"text":"1.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"Matt. xxiv, 1; Luke xxi, 5.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"4.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":4,"text":"Two questions are here asked; the one concerning the destruction of Jerusalem: the other concerning the end of the world.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":5,"text":"9.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":6,"text":"Luke xxi, 12.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":7,"text":"10.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":8,"text":"Matt. xxiv, 14.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":9,"text":"11.","sourceParagraph":5,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":10,"text":"The Holy Ghost will help you.","sourceParagraph":5,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":11,"text":"But do not depend upon any other help For all the nearest ties will be broken.","sourceParagraph":5,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":12,"text":"14.","sourceParagraph":6,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":13,"text":"Where it ought not - That place being set apart for sacred use.","sourceParagraph":6,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":14,"text":"Matt. xxiv, 15; Luke xxi, 20; Dan. ix, 27.","sourceParagraph":6,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":15,"text":"19.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":16,"text":"In those days shall be affliction, such as was not from the beginning of the creation - May it not be doubted, whether this be yet fully accomplished?","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":17,"text":"Is not much of this affliction still to come?","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":18,"text":"20.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":19,"text":"The elect - The Christians: whom he hath chosen - That is, hath taken out of, or separated from, the world, through sanctification of the Spirit and belief of the truth.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":20,"text":"He hath shortened - That is, will surely shorten.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":21,"text":"21.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":22,"text":"Matt. xxiv, 23.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":23,"text":"24.","sourceParagraph":10,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":24,"text":"But in those days - Which immediately precede the end of the world: after that tribulation - Above described.","sourceParagraph":10,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":25,"text":"28.","sourceParagraph":11,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":26,"text":"Matt. xxiv, 32; Luke xxi, 28.","sourceParagraph":11,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":27,"text":"29.","sourceParagraph":12,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":28,"text":"He is nigh - The Son of man.","sourceParagraph":12,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":29,"text":"30.","sourceParagraph":13,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":30,"text":"All these things - Relating to the temple and the city.","sourceParagraph":13,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":31,"text":"32.","sourceParagraph":14,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":32,"text":"Of that day - The day of judgment is often in the Scriptures emphatically called that day.","sourceParagraph":14,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":33,"text":"Neither the Son - Not as man: as man he was no more omniscient than omnipresent.","sourceParagraph":14,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":34,"text":"But as God he knows all the circumstances of it.","sourceParagraph":14,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":35,"text":"33.","sourceParagraph":15,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":36,"text":"Matt. xxiv, 42; Luke xxi, 34.","sourceParagraph":15,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":37,"text":"34.","sourceParagraph":16,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":38,"text":"The Son of man is as a man taking a far journey - Being about to leave this world and go to the Father, he appoints the services that are to be performed by all his servants, in their several stations.","sourceParagraph":16,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":39,"text":"This seems chiefly to respect ministers at the day of judgment: but it may be applied to all men, and to the time of death.","sourceParagraph":16,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":40,"text":"Matt. xxv, 14; Luke xix, 12.","sourceParagraph":16,"scriptureVerseStart":34,"scriptureVerseEnd":34}],"scriptureReference":{"book":"Mark","chapter":13}}