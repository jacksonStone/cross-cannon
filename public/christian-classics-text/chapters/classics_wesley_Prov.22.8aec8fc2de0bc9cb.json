{"author":"John Wesley","book":"Notes on the Bible","chapter":909,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.22","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 22","reference":"Proverbs 22","notes":[],"verses":[{"verse":1,"text":"1. favour - A good report among men, especially good men, and that hearty kindness which attends it.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":3,"text":"Meet - They live together, and need one another.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":4,"text":"The maker - Not only as they are men, but as they are poor or rich, which difference comes from God's providence.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"They have one common creator, and Lord, and judge, and the one cannot despise nor grudge at the other without reflecting upon God.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"The evil - The judgment of God threatened, and approaching.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"Hideth - Retires to his strong tower, by prayer and repentance, puts himself under the protection of the almighty.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Pass on - Carefully and securely.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"Depart - Not easily and ordinarily.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"Is servant - Is at his mercy, and forced to comply with his pleasure.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":15,"text":"The rod - That power which he used with fury shall be taken from him.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"9.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":17,"text":"He - Who looks upon the wants and miseries of others with compassion.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":18,"text":"12.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":19,"text":"Preserve - God by the watchful eye of his providence maintains and defends.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":20,"text":"Knowledge - Men of knowledge, knowing and good men.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":21,"text":"The matters - All his hopes, enterprizes, and concerns.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":22,"text":"14.","sourceParagraph":9,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":23,"text":"The mouth - Her fair and flattering speeches.","sourceParagraph":9,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":24,"text":"15.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":25,"text":"Bound - Is fixed and settled there, as being born with him, and rooted in his very nature.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":26,"text":"16.","sourceParagraph":11,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":27,"text":"That giveth - That prodigally casts away his estate upon those who do not need it.","sourceParagraph":11,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":28,"text":"17.","sourceParagraph":12,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":29,"text":"My knowledge - The knowledge of God, which I am here delivering.","sourceParagraph":12,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":30,"text":"18.","sourceParagraph":13,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":31,"text":"Fitted - Fitly expressed: thou wilt be able to discourse profitably of them.","sourceParagraph":13,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":32,"text":"20.","sourceParagraph":14,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":33,"text":"In counsels and knowledge - In counsels which proceed from found knowledge.","sourceParagraph":14,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":34,"text":"21.","sourceParagraph":15,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":35,"text":"Answer - That thou mayst be able to give solid, and satisfactory answers.","sourceParagraph":15,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":36,"text":"22.","sourceParagraph":16,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":37,"text":"In the gate - Under pretense of justice.","sourceParagraph":16,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":38,"text":"23.","sourceParagraph":17,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":39,"text":"Spoil the soul - Take away not only their goods but their lives too.","sourceParagraph":17,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":40,"text":"29.","sourceParagraph":18,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":41,"text":"Before kings - He is fit to be employed in the affairs of princes.","sourceParagraph":18,"scriptureVerseStart":29,"scriptureVerseEnd":29}],"scriptureReference":{"book":"Proverbs","chapter":22}}