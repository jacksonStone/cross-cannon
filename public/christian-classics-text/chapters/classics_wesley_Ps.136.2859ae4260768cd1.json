{"author":"John Wesley","book":"Notes on the Bible","chapter":873,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.136","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 136","reference":"Psalms 136","notes":[],"verses":[{"verse":1,"text":"We must praise God as great and good in himself, ver.","sourceParagraph":1},{"verse":2,"text":"1- 3.","sourceParagraph":1},{"verse":3,"text":"As the Creator of the world, ver.","sourceParagraph":1},{"verse":4,"text":"4-9.","sourceParagraph":1},{"verse":5,"text":"As Israel's God, ver.","sourceParagraph":1},{"verse":6,"text":"10- 22.","sourceParagraph":1},{"verse":7,"text":"As our Redeemer, ver.","sourceParagraph":1},{"verse":8,"text":"23, 24.","sourceParagraph":1},{"verse":9,"text":"As God over all, ver.","sourceParagraph":1},{"verse":10,"text":"25, 26.","sourceParagraph":1},{"verse":11,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"The God of gods - Who is infinitely superior to all that are called gods, whether angels, or princes, or idols.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"22.","sourceParagraph":3,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":14,"text":"Israel - He speaks of all that people as of one man, because they were united together in one body in the worship of God.","sourceParagraph":3,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":15,"text":"25.","sourceParagraph":4,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":16,"text":"Food - To all living creatures.","sourceParagraph":4,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":17,"text":"For which God deserves great praises, which the psalmist teaches us to render to God for them, because those who are most concerned, either cannot, or do not perform this duty.","sourceParagraph":4,"scriptureVerseStart":25,"scriptureVerseEnd":25}],"scriptureReference":{"book":"Psalms","chapter":136}}