{"author":"John Wesley","book":"Notes on the Bible","chapter":789,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.52","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 52","reference":"Psalms 52","notes":[],"verses":[{"verse":1,"text":"The wickedness of Doeg, and his doom, ver.","sourceParagraph":1},{"verse":2,"text":"1-5.","sourceParagraph":1},{"verse":3,"text":"The righteous will see it and fear, ver.","sourceParagraph":1},{"verse":4,"text":"6, 7.","sourceParagraph":1},{"verse":5,"text":"David comforts himself in God, ver.","sourceParagraph":1},{"verse":6,"text":"8, 9.","sourceParagraph":1},{"verse":7,"text":"To the chief musician, Maschil, A psalm of David, when Doeg the Edomite came and told Saul, and said unto him, David is come to the house of Ahimelech.","sourceParagraph":1},{"verse":8,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"Continually - God is continually doing good: thou art continually doing mischief.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":10,"text":"O mighty - He speaks ironically.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"O valiant captain!","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":12,"text":"To kill a few weak and unarmed persons.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":13,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":14,"text":"Deviseth - Expresses what thy wicked mind had devised.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":15,"text":"Deceitfully - Doeg pretended only to vindicate himself from disloyalty, 1 Sam. xxii, 8, but he really intended to expose the priests, to the king's fury.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":16,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":17,"text":"Pluck thee - Violently and suddenly as the Hebrew word signifies, from thy house and lands, and all the wages of thy righteousness.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":18,"text":"Root - Though thou seemest to have taken deep root, yet God shall pluck thee up by the very roots, and destroy thee both root and branch.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":19,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":20,"text":"Fear - Reverence God's just judgment.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":21,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"The house - In God's church, or among his people.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":23,"text":"9.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":24,"text":"Thou hast - Destroyed mine and thine implacable enemies, and established me in the throne, of which I am no less assured, than if it were already done.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":25,"text":"I will continue in thy way, placing my whole confidence in thy power and goodness, and faithfulness.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":26,"text":"Before - In the presence of thy saints.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9}],"scriptureReference":{"book":"Psalms","chapter":52}}