{"author":"John Wesley","book":"Notes on the Bible","chapter":679,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Neh.7","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Nehemiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Nehemiah 7","reference":"Nehemiah 7","notes":[],"verses":[{"verse":1,"text":"Nehemiah appoints persons to keep the city, ver.","sourceParagraph":1},{"verse":2,"text":"1-4.","sourceParagraph":1},{"verse":3,"text":"Reviews the people, ver.","sourceParagraph":1},{"verse":4,"text":"5-7.","sourceParagraph":1},{"verse":5,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"Hot - 'Till it be clear and broad day; when the people will be ready in case of an assault.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"They - The watches appointed to that end.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"Watches - Nehemiah was now about to return to the court, and left the charge of the city to these in his absence.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"God put it into mine heart - Whatever good motion is in our minds, we must acknowledge it to come from God.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"What is done by human prudence is to be ascribed to the direction of Divine Providence.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"Tirshatha - Nehemiah.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"So it is no wonder that the number of the monies, and other things here contributed, differ from that Ezra ii, 68, 69, because this is another collection.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Nehemiah","chapter":7}}