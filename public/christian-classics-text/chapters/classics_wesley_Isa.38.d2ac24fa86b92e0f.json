{"author":"John Wesley","book":"Notes on the Bible","chapter":976,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Isa.38","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Isaiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Isaiah 38","reference":"Isaiah 38","notes":[],"verses":[{"verse":1,"text":"Hezekiah in his sickness receives from Isaiah a message of death, ver.","sourceParagraph":1},{"verse":2,"text":"1.","sourceParagraph":1},{"verse":3,"text":"By prayer, ver.","sourceParagraph":1},{"verse":4,"text":"2, 3. hath his life lengthened; the sun goeth backward for a sign thereof, ver.","sourceParagraph":1},{"verse":5,"text":"4-8.","sourceParagraph":1},{"verse":6,"text":"His song of praise to God, ver.","sourceParagraph":1},{"verse":7,"text":"9-20.","sourceParagraph":1},{"verse":8,"text":"13.","sourceParagraph":2,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":9,"text":"I reckon - When I could not rest all the night even 'till morning, my thoughts were presaging that God would instantly break me to pieces, and the like thoughts followed me from morning 'till evening.","sourceParagraph":2,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":10,"text":"16.","sourceParagraph":3,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":11,"text":"By these - By thy promises, and thy performance of them; therefore it is not strange, that one word of God hath brought me back from the jaws of death.","sourceParagraph":3,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":12,"text":"18.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":13,"text":"Praise - The dead are not capable of glorifying thy name among men upon earth.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":14,"text":"They cannot expect nor receive the accomplishment of thy promised goodness in the land of the living.","sourceParagraph":4,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":15,"text":"20.","sourceParagraph":5,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":16,"text":"Was ready - Was a present help.","sourceParagraph":5,"scriptureVerseStart":20,"scriptureVerseEnd":20}],"scriptureReference":{"book":"Isaiah","chapter":38}}