{"author":"Robert Jamieson, A. R. Fausset and David Brown","book":"Commentary Critical and Explanatory on the Whole Bible","chapter":657,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:jfb:Prov.29","lineage":[],"metadata":{"author":"Robert Jamieson, A. R. Fausset and David Brown","authorshipDateRange":"19th century","genre":"Commentaries","tradition":"Protestant","translator":null,"edition":"1871 one-volume text; expanded electronic edition by Ernie Stefanik","rights":"Public Domain","source":{"id":"jfb","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"searchIndexed":false},"originalBook":"Proverbs","sourceVolumeId":"jfb","source":{"id":"jfb","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"title":"Proverbs 29","reference":"Proverbs 29","notes":[],"verses":[{"verse":1,"text":"Pr 29:1-27.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"1. hardeneth … neck—obstinately refuses counsel (2Ki 17:14; Ne 9:16).","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"destroyed—literally, \"shivered\" or \"utterly broken to pieces.\"","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"without remedy—literally, \"without healing\" or repairing.","sourceParagraph":4,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"2.","sourceParagraph":5,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"(Compare Pr 11:10; 28:28).","sourceParagraph":5,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"in authority—(Compare Margin), increased in power.","sourceParagraph":6,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"3.","sourceParagraph":7,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"(Compare Pr 4:6, 7; 10:1, &c.).","sourceParagraph":7,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"4. by judgment—that is, righteous decisions, opposed to those procured by gifts (compare Pr 28:21), by which good government is perverted.","sourceParagraph":8,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"land—for nation.","sourceParagraph":9,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"5.","sourceParagraph":10,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"(Compare Pr 26:28).","sourceParagraph":10,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"spreadeth … feet—By misleading him as to his real character, the flatterer brings him to evil, prepared by himself or others.","sourceParagraph":11,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"6.","sourceParagraph":12,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"In—or, \"By\"","sourceParagraph":12,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"the transgression—he is brought into difficulty (Pr 12:13), but the righteous go on prospering, and so sing or rejoice.","sourceParagraph":13,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"7. considereth—literally, \"knows,\" as Ps 1:6.","sourceParagraph":14,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":19,"text":"the cause—that is, in courts of justice (compare Pr 29:14).","sourceParagraph":15,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":20,"text":"The voluntary neglect of it by the wicked (Pr 28:27) occasions oppression.","sourceParagraph":15,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":21,"text":"8.","sourceParagraph":16,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"Scornful men—those who contemptuously disregard God's law.","sourceParagraph":16,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":23,"text":"bring—(Compare Margin), kindle strife.","sourceParagraph":17,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":24,"text":"turn away wrath—that is, \"abate wrath.\"","sourceParagraph":18,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":25,"text":"9. contendeth—that is, in law.","sourceParagraph":19,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":26,"text":"whether … laugh—The fool, whether angry or good-humored, is unsettled; or referring the words to the wise man, the sense is, that all his efforts, severe or gentle, are unavailing to pacify the fool.","sourceParagraph":20,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":27,"text":"10. bloodthirsty—(Compare Margin), murderers (Ps 5:6; 26:9).","sourceParagraph":21,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":28,"text":"hate, &c.—(Pr 1:11; Ge 3:4).","sourceParagraph":22,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":29,"text":"seek … soul—that is, to preserve it.","sourceParagraph":23,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":30,"text":"11.","sourceParagraph":24,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":31,"text":"(Compare Pr 12:16; 16:32).","sourceParagraph":24,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":32,"text":"mind—or, \"spirit,\" for anger or any ill passion which the righteous restrain.","sourceParagraph":25,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":33,"text":"12.","sourceParagraph":26,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":34,"text":"His servants imitate him.","sourceParagraph":26,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":35,"text":"13.","sourceParagraph":27,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":36,"text":"(Compare Pr 22:2).","sourceParagraph":27,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":37,"text":"deceitful man—literally, \"man of vexations,\" an exactor.","sourceParagraph":28,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":38,"text":"the Lord … their eyes—sustains their lives (1Sa 14:27; Ps 13:3); that is, both depend on Him, and He will do justice.","sourceParagraph":29,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":39,"text":"14.","sourceParagraph":30,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":40,"text":"(Compare Pr 20:28; 25:5).","sourceParagraph":30,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":41,"text":"Such is the character of the King of kings (Ps 72:4, 12).","sourceParagraph":30,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":42,"text":"15.","sourceParagraph":31,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":43,"text":"(Compare Pr 13:24; 23:13).","sourceParagraph":31,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":44,"text":"16.","sourceParagraph":32,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":45,"text":"(Compare Pr 29:2, 12; Ps 12:1-8).","sourceParagraph":32,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":46,"text":"shall see … fall—and triumph in it (Ps 37:34-38; 58:10, 11).","sourceParagraph":33,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":47,"text":"17.","sourceParagraph":34,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":48,"text":"(Compare Pr 29:3, 15; Pr 19:18).","sourceParagraph":34,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":49,"text":"give thee rest—peace and quiet (compare Pr 29:9).","sourceParagraph":35,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":50,"text":"18. no vision—instruction in God's truth, which was by prophets, through visions (1Sa 3:1).","sourceParagraph":36,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":51,"text":"people perish—(Compare Margin), are deprived of moral restraints.","sourceParagraph":37,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":52,"text":"keepeth the law—has, and observes, instruction (Pr 14:11, 34; Ps 19:11).","sourceParagraph":38,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":53,"text":"19.","sourceParagraph":39,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":54,"text":"A servant—who lacks good principle.","sourceParagraph":39,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":55,"text":"corrected—or discovered.","sourceParagraph":40,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":56,"text":"will not answer—that is, will not obey.","sourceParagraph":41,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":57,"text":"20.","sourceParagraph":42,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":58,"text":"(Compare Pr 21:5).","sourceParagraph":42,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":59,"text":"hasty in … words?—implying self-conceit (Pr 26:12).","sourceParagraph":43,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":60,"text":"21. become his son—assume the place and privileges of one.","sourceParagraph":44,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":61,"text":"22.","sourceParagraph":45,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":62,"text":"(Compare Pr 15:18).","sourceParagraph":45,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":63,"text":"Such are delighted by discord and violence.","sourceParagraph":45,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":64,"text":"23.","sourceParagraph":46,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":65,"text":"(Compare Pr 16:18; 18:12).","sourceParagraph":46,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":66,"text":"honour … spirit—or, \"such shall lay hold on honor\" (Pr 11:16).","sourceParagraph":47,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":67,"text":"24. hateth … soul—(Compare Pr 8:36).","sourceParagraph":48,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":68,"text":"heareth cursing—(Le 5:1), risks the punishment, rather than reveal truth.","sourceParagraph":49,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":69,"text":"25.","sourceParagraph":50,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":70,"text":"The fear … snare—involves men in difficulty (compare Pr 29:6).","sourceParagraph":50,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":71,"text":"shall be safe—(Compare Margin; Pr 18:10).","sourceParagraph":51,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":72,"text":"26.","sourceParagraph":52,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":73,"text":"(Compare Margin; Ps 27:8).","sourceParagraph":52,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":74,"text":"God alone will and can do exact justice.","sourceParagraph":52,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":75,"text":"27.","sourceParagraph":53,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":76,"text":"(Compare Pr 3:32).","sourceParagraph":53,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":77,"text":"On last clause, compare Pr 29:16; Ps 37:12.","sourceParagraph":53,"scriptureVerseStart":27,"scriptureVerseEnd":27}],"scriptureReference":{"book":"Proverbs","chapter":29}}