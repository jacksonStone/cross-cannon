nstance of his good providence.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"14.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":19,"text":"Judge - Will in due time plead the cause of his people.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":20,"text":"Repent - He will recall that severe sentence which for their sins he had passed upon them.","scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Psalms","chapter":135}}