{"author":"John Wesley","book":"Notes on the Bible","chapter":808,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.71","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 71","reference":"Psalms 71","notes":[],"verses":[{"verse":1,"text":"David wrote this psalm in his old age, of which the former part is prayer, ver.","sourceParagraph":1},{"verse":2,"text":"1-13.","sourceParagraph":1},{"verse":3,"text":"The latter part, joyful praise and thanksgiving, ver.","sourceParagraph":1},{"verse":4,"text":"14-24.","sourceParagraph":1},{"verse":5,"text":"7.","sourceParagraph":2,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":6,"text":"A wonder - For my many and sore calamities.","sourceParagraph":2,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":7,"text":"15.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":8,"text":"The numbers - Of thy salvations and mercies vouchsafed to me.","sourceParagraph":3,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":9,"text":"16.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":10,"text":"Make mention - To support and comfort myself with the remembrance of it.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":11,"text":"Righteousness - Of thy faithfulness in making good all thy promises.","sourceParagraph":4,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":12,"text":"19.","sourceParagraph":5,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":13,"text":"Very high - Most eminent.","sourceParagraph":5,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":14,"text":"20.","sourceParagraph":6,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":15,"text":"Bring me - From the grave.","sourceParagraph":6,"scriptureVerseStart":20,"scriptureVerseEnd":20}],"scriptureReference":{"book":"Psalms","chapter":71}}