the foundation of all religion, without which men would desperately proceed in their impious courses.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"I wait - That he would pardon my sins.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"They - Whether soldiers that keep the night-watches in an army, or the priests or Levites who did so in the temple.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":17,"text":"Israel - Every true Israelite.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"Plenteous - Abundantly sufficient for all persons who accept it upon God's terms.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Psalms","chapter":130}}