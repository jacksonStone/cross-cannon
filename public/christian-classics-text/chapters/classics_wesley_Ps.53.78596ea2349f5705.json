{"author":"John Wesley","book":"Notes on the Bible","chapter":790,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.53","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 53","reference":"Psalms 53","notes":[],"verses":[{"verse":1,"text":"David here describes the wickedness of mankind, nearly in the same words as in chap. xiv.","sourceParagraph":1},{"verse":2,"text":"To the chief musician upon Mahalath, Maschil, A psalm of David.","sourceParagraph":1},{"verse":3,"text":"Title of the psalm.","sourceParagraph":1},{"verse":4,"text":"Mahalath - This also seems to be the name of a musical instrument, or tune.","sourceParagraph":1},{"verse":5,"text":"5.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":6,"text":"Scattered - Hath not only broken their bones, their strength, and force, but also dispersed them hither and thither, so as there is no hope of a restoration.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":7,"text":"Thee - Against my people.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"Thou - Thou oh Jerusalem, which they besiege.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5}],"scriptureReference":{"book":"Psalms","chapter":53}}