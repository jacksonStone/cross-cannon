{"author":"John Wesley","book":"Notes on the Bible","chapter":1046,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Jer.42","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Jeremiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Jeremiah 42","reference":"Jeremiah 42","notes":[],"verses":[{"verse":1,"text":"Johanan and the people desire Jeremiah to inquire of God, promising obedience to his will, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"Jeremiah assures them of safety in Judea, ver.","sourceParagraph":1},{"verse":4,"text":"7-12. and destruction in Egypt, ver.","sourceParagraph":1},{"verse":5,"text":"13-18.","sourceParagraph":1},{"verse":6,"text":"Reproves their hypocrisy and obstinacy, ver.","sourceParagraph":1},{"verse":7,"text":"19-22.","sourceParagraph":1},{"verse":8,"text":"6.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":9,"text":"Good or evil - Whether grateful or ungrateful to us.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":10,"text":"10.","sourceParagraph":3,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":11,"text":"I repent - I am satisfied with the punishment your nation hath undergone, and as to the remainder, will change the course of my providence.","sourceParagraph":3,"scriptureVerseStart":10,"scriptureVerseEnd":10}],"scriptureReference":{"book":"Jeremiah","chapter":42}}