{"author":"John Wesley","book":"Notes on the Bible","chapter":190,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:2Thess.3","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"2 Thessalonians","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"2 Thessalonians 3","reference":"2 Thessalonians 3","notes":[],"verses":[{"verse":1,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"May run - Go on swiftly, without any interruption.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"And be glorified - Acknowledged as divine, and bring forth much fruit.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"All men have not faith - And all men who have not are more or less unreasonable and wicked men.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"Who will stablish you - That cleave to him by faith.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"And guard you from the evil one - And all his instruments.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"We trust in the Lord concerning you - Thus only should we trust in any man.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"Now the Lord - The Spirit, whose proper work this is.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"Direct - Lead you straight forward.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"Into the patience of Christ - Of which he set you a pattern.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"That walketh disorderly - Particularly by not working.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"Not according to the tradition he received of us - The admonition we gave, both by word of mouth, and in our former epistle.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"10.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":19,"text":"Neither let him eat - Do not maintain him in idleness.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":20,"text":"11.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":21,"text":"Doing nothing, but being busybodies - To which idleness naturally disposes.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":22,"text":"12.","scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":23,"text":"Work quietly - Letting the concerns of other people alone.","scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":24,"text":"14.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":25,"text":"Have no company with him - No intimacy, no familiarity, no needless correspondence.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":26,"text":"15.","scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":27,"text":"Admonish him as a brother - Tell him lovingly of the reason why you shun him.","scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":28,"text":"16.","scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":29,"text":"The Lord of peace - Christ.","scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":30,"text":"Give you peace by all means - In every way and manner.","scriptureVerseStart":16,"scriptureVerseEnd":16}],"scriptureReference":{"book":"2 Thessalonians","chapter":3}}