{"author":"John Wesley","book":"Notes on the Bible","chapter":849,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.112","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 112","reference":"Psalms 112","notes":[],"verses":[{"verse":1,"text":"This also is an alphabetical psalm.","sourceParagraph":1},{"verse":2,"text":"We have here the character and blessedness of the righteous, ver.","sourceParagraph":1},{"verse":3,"text":"1-9.","sourceParagraph":1},{"verse":4,"text":"The iniquity of the wicked, ver.","sourceParagraph":1},{"verse":5,"text":"10.","sourceParagraph":1},{"verse":6,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"Generation - The posterity.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Righteousness - The fruit or reward of his righteousness, which is God's blessing upon his estate.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"Darkness - In the troubles and calamities of life.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"He - The upright man.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"Lendeth - Gives freely to some, and lends to others according to the variety of their conditions.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"Affairs - His domestick affairs.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":16,"text":"Discretion - Not getting his estate unjustly, nor casting it away prodigally, nor yet withholding it from such as need it.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":17,"text":"6.","sourceParagraph":6,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"Moved - Though he may for a season be afflicted, yet he shall not be eternally destroyed.","sourceParagraph":6,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"7.","sourceParagraph":7,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":20,"text":"Evil tidings - At the report of approaching calamities.","sourceParagraph":7,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":21,"text":"9.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"Dispersed - His goods, freely and liberally.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"Righteousness - His liberality, or the reward of it.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":24,"text":"Ever - What he gives is not lost, but indeed is the only part of his estate, which will abide with him to all eternity.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":25,"text":"10.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":26,"text":"The desire - Either of the misery of good men; or of his own constant prosperity.","sourceParagraph":9,"scriptureVerseStart":10,"scriptureVerseEnd":10}],"scriptureReference":{"book":"Psalms","chapter":112}}