{"author":"John Wesley","book":"Notes on the Bible","chapter":898,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.11","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 11","reference":"Proverbs 11","notes":[],"verses":[{"verse":1,"text":"1.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"A false balance - The use of all false weights and measures in commerce.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"8.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":4,"text":"Cometh - Into trouble.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":5,"text":"9.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":6,"text":"Delivered - From the infection of the hypocrite's evil counsel.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":7,"text":"11.","sourceParagraph":4,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":8,"text":"The blessing - Wherewith they bless the city, by their sincere prayers, and wise and wholesome counsels.","sourceParagraph":4,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":9,"text":"The mouth - By their curses, and oaths, and blasphemies, and wicked counsels.","sourceParagraph":4,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":10,"text":"12.","sourceParagraph":5,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":11,"text":"Despiseth - Which he shews by contemptuous or reproachful expressions.","sourceParagraph":5,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":12,"text":"Holdeth peace - Forbears all such expressions, and silently and patiently bears those reproaches.","sourceParagraph":5,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":13,"text":"13.","sourceParagraph":6,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":14,"text":"Secrets - Such things as were committed to his trust with a charge of secrecy.","sourceParagraph":6,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":15,"text":"16.","sourceParagraph":7,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":16,"text":"Gracious woman - A woman endued with the grace of God.","sourceParagraph":7,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":17,"text":"Retaineth - Or, holdeth fast her honour, or reputation.","sourceParagraph":7,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":18,"text":"18.","sourceParagraph":8,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":19,"text":"Worketh - A work which will deceive his expectation.","sourceParagraph":8,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":20,"text":"Soweth - That worketh it with constancy, and diligence.","sourceParagraph":8,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":21,"text":"21.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":22,"text":"Though hand join - Though they are fortified against God's judgments by a numerous issue and kindred, and friends, and by mutual and strong combinations.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":23,"text":"The seed - Not only their persons, but their children.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":24,"text":"22.","sourceParagraph":10,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":25,"text":"So is a fair woman without discretion - \"Of beauty vain, of virtue void, What art thou in the sight of God?","sourceParagraph":10,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":26,"text":"A slave to every base desire, A creature wallowing in the mire.","sourceParagraph":10,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":27,"text":"Go, gaudy pageant of a day, Thy folly, with thy face display: Set all thy charms and graces out, And shew - the Jewel in thy snout!\"","sourceParagraph":10,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":28,"text":"23.","sourceParagraph":11,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":29,"text":"The desire - The desires and expectations of the righteous shall end in their happiness, but the desires and expectations of the wicked men shall be disappointed, and end in the wrath of God.","sourceParagraph":11,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":30,"text":"24.","sourceParagraph":12,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":31,"text":"Scattereth - That gives liberally.","sourceParagraph":12,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":32,"text":"Increaseth - Through God's blessing upon his estate.","sourceParagraph":12,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":33,"text":"Poverty - By God's providence secretly blasting his estate.","sourceParagraph":12,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":34,"text":"25.","sourceParagraph":13,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":35,"text":"Fat - Shall be enriched both with temporal and spiritual blessings.","sourceParagraph":13,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":36,"text":"26.","sourceParagraph":14,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":37,"text":"With-holdeth corn - In a time of scarcity.","sourceParagraph":14,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":38,"text":"Selleth - Upon reasonable terms.","sourceParagraph":14,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":39,"text":"27.","sourceParagraph":15,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":40,"text":"Seeketh - To do good to all men. favour - With God and men.","sourceParagraph":15,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":41,"text":"29.","sourceParagraph":16,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":42,"text":"Troubleth - He who brings trouble upon himself and children, either by prodigality, or by restless endeavours to heap up riches.","sourceParagraph":16,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":43,"text":"Wind - Shall be as unable to keep what he gets as a man is to hold the wind in his hand.","sourceParagraph":16,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":44,"text":"30.","sourceParagraph":17,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":45,"text":"The fruit - His discourses and his whole conversation, is like the fruit of the tree of life.","sourceParagraph":17,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":46,"text":"Winneth - That gains souls to God.","sourceParagraph":17,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":47,"text":"31.","sourceParagraph":18,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":48,"text":"Recompensed - Punished for his sins.","sourceParagraph":18,"scriptureVerseStart":31,"scriptureVerseEnd":31}],"scriptureReference":{"book":"Proverbs","chapter":11}}