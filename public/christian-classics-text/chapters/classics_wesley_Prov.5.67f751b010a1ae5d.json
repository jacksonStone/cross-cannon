{"author":"John Wesley","book":"Notes on the Bible","chapter":892,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.5","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 5","reference":"Proverbs 5","notes":[],"verses":[{"verse":1,"text":"A farther exhortation to wisdom, ver.","sourceParagraph":1},{"verse":2,"text":"1, 2.","sourceParagraph":1},{"verse":3,"text":"A caution against whoredom, ver.","sourceParagraph":1},{"verse":4,"text":"3-14.","sourceParagraph":1},{"verse":5,"text":"Remedies against it, ver.","sourceParagraph":1},{"verse":6,"text":"15-23.","sourceParagraph":1},{"verse":7,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"The lips - It concerns thee to get and to use discretion, that thou mayest be able to resist those temptations to which thou art exposed.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"But - The effect of that to which she entices men, is destruction.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"Feet - Her manner of life.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"Lest - To prevent thy serious consideration.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"Moveable - She transforms herself into several shapes, and has a thousand arts to ensnare.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"Know - Thou canst not discover all her practice.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"9. honour - Thy dignity and reputation, the strength of thy body and mind.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":18,"text":"Years - The flower of thine age.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":19,"text":"The cruel - To the harlot, who though she pretends love, yet in truth is one of the most cruel creatures in the world, wasting thy estate and body without pity, and damming thy soul forever.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":20,"text":"10.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":21,"text":"Strangers - Not only the strange women themselves, but others who are in league with them. labours - Wealth gotten by thy labours.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"14.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":23,"text":"A moment - In how little a time am I now come into remediless misery!","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":24,"text":"Assembly - And that in the congregation of Israel, where I was taught better things.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":25,"text":"15.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":26,"text":"Drink - Content thyself with those delights which God alloweth thee in the sober use of the marriage-bed.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":27,"text":"16.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":28,"text":"Fountains - Thy children proceeding from thy wife and from thyself.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":29,"text":"Fountains are here put for rivers flowing from them.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":30,"text":"Dispersed - They shall in due time appear abroad to thy comfort, and for the good of others.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":31,"text":"18.","sourceParagraph":10,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":32,"text":"Fountain - Thy wife.","sourceParagraph":10,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":33,"text":"Blessed - With children; for barrenness was esteemed a curse among the Israelites.","sourceParagraph":10,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":34,"text":"19.","sourceParagraph":11,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":35,"text":"Satisfy thee - At all convenient times: for that there may be excess in the marriage-bed is manifest.","sourceParagraph":11,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":36,"text":"Ravished - Love her fervently.","sourceParagraph":11,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":37,"text":"It is an hyperbolical expression.","sourceParagraph":11,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":38,"text":"22.","sourceParagraph":12,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":39,"text":"Holden - He is in perfect bondage to his lusts, and is neither able nor wiling to set himself at liberty.","sourceParagraph":12,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":40,"text":"23.","sourceParagraph":13,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":41,"text":"Die - He shall die in his sins.","sourceParagraph":13,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":42,"text":"Astray-From the way of life, and from eternal salvation.","sourceParagraph":13,"scriptureVerseStart":23,"scriptureVerseEnd":23}],"scriptureReference":{"book":"Proverbs","chapter":5}}