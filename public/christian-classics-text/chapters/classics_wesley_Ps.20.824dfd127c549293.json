{"author":"John Wesley","book":"Notes on the Bible","chapter":757,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.20","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 20","reference":"Psalms 20","notes":[],"verses":[{"verse":1,"text":"A prayer for the king, ver.","sourceParagraph":1},{"verse":2,"text":"1-4.","sourceParagraph":1},{"verse":3,"text":"The king and the people rejoice in God, and pray for his help, ver.","sourceParagraph":1},{"verse":4,"text":"5-9.","sourceParagraph":1},{"verse":5,"text":"To the chief musician, A psalm of David.","sourceParagraph":1},{"verse":6,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"God of Jacob - God had made a covenant with Jacob and his posterity.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"Sanctuary - From the tabernacle in Zion, where the ark then was; toward which the Israelites directed their prayers.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"Rejoice - Hereby they shew their confidence in God, and their assurance of the victory.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"Name - To the honour of God.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"Set up - In way of triumph.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"Now - We are already sure of victory by the consideration of God's power and faithfulness and love to David, and to his people.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"They speak as one person, because they were unanimous in this prayer.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"Saveth - Will certainly save.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"Strength - This shews how God will hear him, even by saving him with a strong hand.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":20,"text":"Remember - Trust in it.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":21,"text":"8.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"Brought down - From their horses and chariots, to which they trusted.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":23,"text":"Stand - Stand firmly, and keep the field.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":24,"text":"9.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":25,"text":"Let the king - God, the supreme monarch, the king of kings, and in a peculiar manner the king of Israel.","sourceParagraph":8,"scriptureVerseStart":9,"scriptureVerseEnd":9}],"scriptureReference":{"book":"Psalms","chapter":20}}