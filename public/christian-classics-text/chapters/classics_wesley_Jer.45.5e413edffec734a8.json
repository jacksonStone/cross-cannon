{"author":"John Wesley","book":"Notes on the Bible","chapter":1049,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Jer.45","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Jeremiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Jeremiah 45","reference":"Jeremiah 45","notes":[],"verses":[{"verse":1,"text":"Jeremiah instructs and comforts Baruch, ver.","sourceParagraph":1},{"verse":2,"text":"1-5.","sourceParagraph":1},{"verse":3,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":4,"text":"I find no rest - Upon Baruch's reading the prophecies both he and Jeremiah were advised to hide themselves.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":5,"text":"This probably disturbed Baruch, and made him lament his condition.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":7,"text":"Seek them not - Dost thou expect what none is like to meet with who feareth God?","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"Upon all flesh - I am bringing calamities upon the whole nation.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5}],"scriptureReference":{"book":"Jeremiah","chapter":45}}