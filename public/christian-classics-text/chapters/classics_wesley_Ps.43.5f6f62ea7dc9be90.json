{"author":"John Wesley","book":"Notes on the Bible","chapter":780,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.43","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 43","reference":"Psalms 43","notes":[],"verses":[{"verse":1,"text":"The psalmist appeals to God, ver."},{"verse":2,"text":"1, 2."},{"verse":3,"text":"Prays to be restored to the public ordinances, and trusts in God, ver."},{"verse":4,"text":"3-5."},{"verse":5,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"Nation - So he calls the company of his enemies for their great numbers.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Man - Probably Achitophel or Absalom.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Send out - That is, actually discover them.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"Truth - Thy favour, or the light of thy countenance, and the truth of thy promises made to me; or the true-light, the illumination of thy spirit, and the direction of thy gracious providence, whereby I may be led in the right way, to thy holy hill.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"Hill - Of Zion, the place of God's presence and worship.","scriptureVerseStart":3,"scriptureVerseEnd":3}],"scriptureReference":{"book":"Psalms","chapter":43}}