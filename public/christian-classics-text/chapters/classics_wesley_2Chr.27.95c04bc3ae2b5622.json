{"author":"John Wesley","book":"Notes on the Bible","chapter":653,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:2Chr.27","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"2 Chronicles","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"2 Chronicles 27","reference":"2 Chronicles 27","notes":[],"verses":[{"verse":1,"text":"Jotham reigns well and prospers, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"The conclusion of his reign, ver.","sourceParagraph":1},{"verse":4,"text":"7-9.","sourceParagraph":1},{"verse":5,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"He did - He did according to all that his father Uzziah did; except in his miscarriages.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"We must not imitate those we have the greatest esteem for, any farther than we do well; but their failings must be warnings to us, to walk more circumspectly.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Built - Repaired it: for it was built before, chap. xi, 5.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3}],"scriptureReference":{"book":"2 Chronicles","chapter":27}}