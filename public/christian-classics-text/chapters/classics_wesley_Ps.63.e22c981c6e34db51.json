{"author":"John Wesley","book":"Notes on the Bible","chapter":800,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.63","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 63","reference":"Psalms 63","notes":[],"verses":[{"verse":1,"text":"David's desire and esteem of God, ver.","sourceParagraph":1},{"verse":2,"text":"1-4.","sourceParagraph":1},{"verse":3,"text":"His satisfaction, and communion with God, ver.","sourceParagraph":1},{"verse":4,"text":"5, 6.","sourceParagraph":1},{"verse":5,"text":"His joyful dependence upon God, ver.","sourceParagraph":1},{"verse":6,"text":"7, 8.","sourceParagraph":1},{"verse":7,"text":"His holy triumph in him, ver.","sourceParagraph":1},{"verse":8,"text":"9-12.","sourceParagraph":1},{"verse":9,"text":"A psalm of David, when he was in the wilderness of Judah.","sourceParagraph":1},{"verse":10,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"Early - Hebrew. in the morning, Which implies the doing it with diligence and speed.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":12,"text":"Thirsteth - For the enjoyment of thee in thy house and ordinances.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":13,"text":"Flesh - The desire of my soul, is so vehement, that my very body feels the effects of it.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":14,"text":"No water - In a land where I want the refreshing waters of the sanctuary.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":15,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":16,"text":"To see - To enjoy.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":17,"text":"Power - The powerful and glorious effects of thy gracious presence.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":18,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":19,"text":"Satisfied - When thou shalt fulfil my earnest desire of enjoying thee in the sanctuary.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":20,"text":"9.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":21,"text":"Shall go - Into the grave.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"10.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":23,"text":"Foxes - Their carcases shall become a prey to wild and ravenous creatures.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":24,"text":"11.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":25,"text":"The king - I who am already anointed king.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":26,"text":"Everyone - That sweareth by the name of God, in truth, and judgment, and righteousness.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":27,"text":"Every sincere servant and worshipper of God.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":28,"text":"Shall glory - Shall rejoice in my deliverance.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11}],"scriptureReference":{"book":"Psalms","chapter":63}}