{"author":"John Wesley","book":"Notes on the Bible","chapter":792,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.55","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 55","reference":"Psalms 55","notes":[],"verses":[{"verse":1,"text":"David complains to God, ver.","sourceParagraph":1},{"verse":2,"text":"1-8.","sourceParagraph":1},{"verse":3,"text":"Prays for help against his enemies, ver.","sourceParagraph":1},{"verse":4,"text":"9-15.","sourceParagraph":1},{"verse":5,"text":"Assures himself of God's protection, ver.","sourceParagraph":1},{"verse":6,"text":"16- 18.","sourceParagraph":1},{"verse":7,"text":"And their destruction, ver.","sourceParagraph":1},{"verse":8,"text":"19-23.","sourceParagraph":1},{"verse":9,"text":"To the chief musician on Neginoth, Maschil, A psalm of David.","sourceParagraph":1},{"verse":10,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"Voice - Their clamours and threats, and slanders.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":12,"text":"Cast - They lay many crimes to my charge.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":13,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"The terrors - Deadly terrors; such as seize upon men in the agonies of death.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":15,"text":"8.","sourceParagraph":4,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"Tempest - From the force and fury of mine enemies.","sourceParagraph":4,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"9.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":18,"text":"Destroy - Destroy them by dividing.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":19,"text":"Tongues - Their speech, as thou didst at Babel, Gen. xi, 9, their votes, and opinions, and counsels.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":20,"text":"Which was eminently done among Absalom's followers, 2 Sam. xvii, 23.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":21,"text":"Strife - Injustice and fraud, oppression and contention rule here, instead of that public justice and peace which I established.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"City - In Jerusalem; which in Absalom's time was a sink of all sins.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"10.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":24,"text":"They - Violence and strife.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":25,"text":"Go about - Do encompass it, as it were a garrison.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":26,"text":"Walls - In the outward parts, as also in the very midst of it.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":27,"text":"So that all parts were horribly corrupted.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":28,"text":"11.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":29,"text":"Streets - The places of buying and selling, and of public commerce.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":30,"text":"12.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":31,"text":"Hated - With a manifest or old hatred.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":32,"text":"13.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":33,"text":"Equal - Not in power, but in reputation, for wisdom, and influence upon my people.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":34,"text":"Guide - Whose counsel I highly prized, and constantly followed.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":35,"text":"All which agrees to Achitophel.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":36,"text":"15.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":37,"text":"Them - All such as pretend to religion, and have manifestly apostatized both from the profession and practice of it.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":38,"text":"The grave - Cut off by a sudden and violent death.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":39,"text":"Among them - Hebrew. in their inwards.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":40,"text":"Wickedness is deeply rooted in their hearts.","sourceParagraph":10,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":41,"text":"17.","sourceParagraph":11,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":42,"text":"Evening, &c. - The three stated times of prayer among the Jews.","sourceParagraph":11,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":43,"text":"18.","sourceParagraph":12,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":44,"text":"He hath - He speaks of a future deliverance, as a thing done, because of the certainty of it.","sourceParagraph":12,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":45,"text":"He hath restored me to my former peace and tranquility.","sourceParagraph":12,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":46,"text":"For - For there were more with me than against me; even the holy angels whom God employed to defend and deliver me.","sourceParagraph":12,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":47,"text":"19.","sourceParagraph":13,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":48,"text":"Hear - My prayers.","sourceParagraph":13,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":49,"text":"Eternity - Who is eternal, and therefore unchangeable, and almighty.","sourceParagraph":13,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":50,"text":"Because - They meet with no crosses nor disappointments.","sourceParagraph":13,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":51,"text":"Therefore - Their success makes them go on securely, without any regard to God, or dread of his judgments.","sourceParagraph":13,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":52,"text":"20.","sourceParagraph":14,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":53,"text":"He - They, the persons last mentioned.","sourceParagraph":14,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":54,"text":"22.","sourceParagraph":15,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":55,"text":"Burden - All thy crosses, and cares, and fears, lay them upon the Almighty, by faith and prayer.","sourceParagraph":15,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":56,"text":"He directs this speech to his own soul, and to all good men in like circumstances.","sourceParagraph":15,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":57,"text":"Suffer - As he doth wicked men.","sourceParagraph":15,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":58,"text":"Tho' he may for a season suffer them to be shaken, yet not to be overwhelmed.","sourceParagraph":15,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":59,"text":"23.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":60,"text":"Them - The wicked.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":61,"text":"Not live - But shall be cut off by an untimely and violent death.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":62,"text":"Trust in thee - And in this confidence I will quietly wait for deliverance.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23}],"scriptureReference":{"book":"Psalms","chapter":55}}