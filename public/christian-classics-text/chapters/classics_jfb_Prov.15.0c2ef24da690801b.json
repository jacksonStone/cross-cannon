{"author":"Robert Jamieson, A. R. Fausset and David Brown","book":"Commentary Critical and Explanatory on the Whole Bible","chapter":643,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:jfb:Prov.15","lineage":[],"metadata":{"author":"Robert Jamieson, A. R. Fausset and David Brown","authorshipDateRange":"19th century","genre":"Commentaries","tradition":"Protestant","translator":null,"edition":"1871 one-volume text; expanded electronic edition by Ernie Stefanik","rights":"Public Domain","source":{"id":"jfb","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"searchIndexed":false},"originalBook":"Proverbs","sourceVolumeId":"jfb","source":{"id":"jfb","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"title":"Proverbs 15","reference":"Proverbs 15","notes":[],"verses":[{"verse":1,"text":"Pr 15:1-33.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"1. soft—tender or gentle.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"turneth … wrath—from any one.","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"stir up—as a smouldering fire is excited.","sourceParagraph":4,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"2. useth … aright—commends knowledge by its proper use.","sourceParagraph":5,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"poureth out—utters abundantly (Pr 12:23), and so disgusts others.","sourceParagraph":6,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"3. beholding—watching (compare Pr 5:21; Ps 66:7).","sourceParagraph":7,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"4.","sourceParagraph":8,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"A wholesome tongue—(Compare Margin), pacifying and soothing language.","sourceParagraph":8,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"tree of life—(Pr 3:18; 11:30).","sourceParagraph":9,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"perverseness therein—cross, ill-natured language.","sourceParagraph":10,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"breach … spirit—(compare Isa 65:14, Hebrew), grieves, instead of appeasing.","sourceParagraph":11,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"5.","sourceParagraph":12,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"(Compare Pr 4:1; 10:17; 13:1-18).","sourceParagraph":12,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"is prudent—acts discreetly.","sourceParagraph":13,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":16,"text":"6. treasure—implying utility.","sourceParagraph":14,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"trouble—vexation and affliction.","sourceParagraph":15,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"7.","sourceParagraph":16,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":19,"text":"(Compare Pr 10:20, 21).","sourceParagraph":16,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":20,"text":"heart … not so—not right, or vain.","sourceParagraph":17,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":21,"text":"8, 9.","sourceParagraph":18,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"The sacrifice [and] prayer—are acts of worship.","sourceParagraph":18,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":23,"text":"way … followeth … righteousness—denote conduct.","sourceParagraph":19,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":24,"text":"God's regard for the worship and deeds of the righteous and wicked respectively, so stated in Ps 50:17; Isa 1:11.","sourceParagraph":19,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":25,"text":"10.","sourceParagraph":20,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":26,"text":"(Compare Pr 10:17).","sourceParagraph":20,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":27,"text":"the way—that in which God would have him to go (Pr 2:13; Ps 119:1).","sourceParagraph":21,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":28,"text":"11.","sourceParagraph":22,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":29,"text":"Hell—(Ps 16:10).","sourceParagraph":22,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":30,"text":"destruction—or, \"Abaddon,\" the place of the destroyer.","sourceParagraph":23,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":31,"text":"All the unseen world is open to God, much more men's hearts.","sourceParagraph":23,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":32,"text":"12.","sourceParagraph":24,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":33,"text":"(Compare Pr 9:8).","sourceParagraph":24,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":34,"text":"go unto the wise—to be instructed.","sourceParagraph":25,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":35,"text":"13. maketh … countenance—or, \"benefits the countenance.\"","sourceParagraph":26,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":36,"text":"spirit is broken—and so the countenance is sad.","sourceParagraph":27,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":37,"text":"14.","sourceParagraph":28,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":38,"text":"(Compare Pr 10:21, 22).","sourceParagraph":28,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":39,"text":"The wise grow wiser, the fools more foolish (Pr 9:9).","sourceParagraph":28,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":40,"text":"15.","sourceParagraph":29,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":41,"text":"The state of the heart governs the outward condition.","sourceParagraph":29,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":42,"text":"evil—sad, contrasted with the cheerfulness of a feast.","sourceParagraph":30,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":43,"text":"16. trouble—agitation, implying the anxieties and perplexities attending wealth held by worldlings (Pr 16:18; 1Ti 6:6).","sourceParagraph":31,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":44,"text":"17. dinner—or, \"allowance\" (2Ki 25:30)—","sourceParagraph":32,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":45,"text":"of herbs—and that the plainest.","sourceParagraph":33,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":46,"text":"and hatred—(compare Pr 10:12, 18).","sourceParagraph":34,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":47,"text":"18.","sourceParagraph":35,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":48,"text":"(Compare Pr 14:29; 16:32).","sourceParagraph":35,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":49,"text":"19.","sourceParagraph":36,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":50,"text":"The difficulties of the slothful result from want of energy; the righteous find a","sourceParagraph":36,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":51,"text":"plain [and open] way—literally, \"a highway,\" by diligence (1Sa 10:7; Ps 1:3).","sourceParagraph":37,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":52,"text":"20.","sourceParagraph":38,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":53,"text":"(Compare Pr 10:1).","sourceParagraph":38,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":54,"text":"21. walketh uprightly—and so finds his joy (Pr 3:6; 10:23).","sourceParagraph":39,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":55,"text":"22.","sourceParagraph":40,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":56,"text":"Without counsel—or, \"deliberation,\" implying a wise deference to the opinions of the wise and good, contrasted with rashness.","sourceParagraph":40,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":57,"text":"23.","sourceParagraph":41,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":58,"text":"Good advice blesses the giver and receiver.","sourceParagraph":41,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":59,"text":"24.","sourceParagraph":42,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":60,"text":"(Compare Col 3:2).","sourceParagraph":42,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":61,"text":"Holy purposes prevent sinning, and so its evils.","sourceParagraph":42,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":62,"text":"25.","sourceParagraph":43,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":63,"text":"The most desolate who have God's aid have more permanent good than the self-reliant sinner (Pr 2:22; 12:7).","sourceParagraph":43,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":64,"text":"border—or, \"boundary for possessions\" (Ps 78:54).","sourceParagraph":44,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":65,"text":"26. are pleasant words—that is, pleasing to God (Pr 8:8, 9).","sourceParagraph":45,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":66,"text":"27.","sourceParagraph":46,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":67,"text":"(Compare Pr 11:17).","sourceParagraph":46,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":68,"text":"Avarice brings trouble to him and his.","sourceParagraph":46,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":69,"text":"hateth gifts—or, \"bribes\" (Ex 23:8; Ps 15:5), and is not avaricious.","sourceParagraph":47,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":70,"text":"28.","sourceParagraph":48,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":71,"text":"(Compare Pr 15:14; 10:11).","sourceParagraph":48,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":72,"text":"Caution is the fruit of wisdom; rashness of folly.","sourceParagraph":48,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":73,"text":"29. far … wicked—in His love and favor (Ps 22:11; 119:155).","sourceParagraph":49,"scriptureVerseStart":29,"scriptureVerseEnd":29},{"verse":74,"text":"30. light of the eyes—(Pr 13:9).","sourceParagraph":50,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":75,"text":"What gives light rejoiceth the heart, by relieving from anxiety as to our course; so","sourceParagraph":50,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":76,"text":"good report—or, \"doctrine\" (Isa 28:9; 53:1),","sourceParagraph":51,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":77,"text":"maketh … fat—or, \"gives prosperity\" (Pr 3:13-17; 9:11).","sourceParagraph":52,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":78,"text":"The last clause is illustrated by the first.","sourceParagraph":52,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":79,"text":"31, 32.","sourceParagraph":53,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":80,"text":"(Compare Pr 10:17).","sourceParagraph":53,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":81,"text":"reproof of life—which leads to life.","sourceParagraph":54,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":82,"text":"abideth … wise—is numbered among them.","sourceParagraph":55,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":83,"text":"32. refuseth—or, \"neglects,\" \"passes by\" (Pr 1:25; 4:15).","sourceParagraph":56,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":84,"text":"despiseth … soul—so acts as if esteeming its interests of no value.","sourceParagraph":57,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":85,"text":"33.","sourceParagraph":58,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":86,"text":"The fear … wisdom—Wisdom instructs in true piety.","sourceParagraph":58,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":87,"text":"before … humility—(compare Lu 24:26; 1Pe 1:11); opposite (compare Pr 16:18).","sourceParagraph":59,"scriptureVerseStart":33,"scriptureVerseEnd":33}],"scriptureReference":{"book":"Proverbs","chapter":15}}