{"author":"John Wesley","book":"Notes on the Bible","chapter":878,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.141","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 141","reference":"Psalms 141","notes":[],"verses":[{"verse":1,"text":"David prays for acceptance and assistance, ver."},{"verse":2,"text":"1-6."},{"verse":3,"text":"For the deliverance of himself and friends, ver."},{"verse":4,"text":"7-10."},{"verse":5,"text":"A psalm of David."},{"verse":6,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"Incline not - Suffer it not to be inclined.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"Heart - Keep me not only from wicked speeches, but from all evil motions of my heart.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"Dainties - The pleasures or advantages which they gain by their wickedness.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"Smite - By reproofs.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"Break - Not hurt, but heal and greatly refresh me.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"Calamities - In the calamities of those righteous persons who reproved him.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"When they came into such calamities as those wherein he was involved he would pity them and pray for them.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"Judges - The chief of mine enemies.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"Overthrown - Or, cast down headlong by thine exemplary vengeance.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"Hear - Hearken unto my counsels and offers which now they despise.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":20,"text":"Our bones - Our case is almost as hopeless as of those who are dead, and whose bones are scattered in several places.","scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Psalms","chapter":141}}