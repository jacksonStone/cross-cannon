{"author":"John Wesley","book":"Notes on the Bible","chapter":801,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.64","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 64","reference":"Psalms 64","notes":[],"verses":[{"verse":1,"text":"David describes his enemies and prays for deliverance from them, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"Foretells their destruction, ver.","sourceParagraph":1},{"verse":4,"text":"7-10.","sourceParagraph":1},{"verse":5,"text":"To the chief musician, A psalm of David.","sourceParagraph":1},{"verse":6,"text":"6.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":7,"text":"Iniquities - They study diligently, to find new ways of doing mischief.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":8,"text":"Deep - Cunning, both to contrive and conceal, and to execute their plots.","sourceParagraph":2,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":9,"text":"8.","sourceParagraph":3,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":10,"text":"Flee - Through fear of being involved in their destruction.","sourceParagraph":3,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":11,"text":"10.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":12,"text":"Glad - For the honour of God, which by this means is vindicated.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10}],"scriptureReference":{"book":"Psalms","chapter":64}}