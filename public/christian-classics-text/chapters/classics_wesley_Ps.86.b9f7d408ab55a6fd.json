{"author":"John Wesley","book":"Notes on the Bible","chapter":823,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.86","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 86","reference":"Psalms 86","notes":[],"verses":[{"verse":1,"text":"David prays for the favour and blessing of God, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"Expresses confidence in him, by praise mingled with prayer, ver.","sourceParagraph":1},{"verse":4,"text":"7-17.","sourceParagraph":1},{"verse":5,"text":"A prayer of David.","sourceParagraph":1},{"verse":6,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"Holy - Sincerely devoted to thy service.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"11.","sourceParagraph":3,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":9,"text":"Truth - In the way of thy precepts, which are true and right in all things.","sourceParagraph":3,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":10,"text":"My heart - Knit my whole heart to thyself.","sourceParagraph":3,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":11,"text":"13.","sourceParagraph":4,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":12,"text":"Hell - From