{"author":"John Wesley","book":"Notes on the Bible","chapter":875,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.138","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 138","reference":"Psalms 138","notes":[],"verses":[{"verse":1,"text":"David praises God for his goodness, and foretells that other kings will praise him, ver.","sourceParagraph":1},{"verse":2,"text":"1-5.","sourceParagraph":1},{"verse":3,"text":"He rejoices in hope of still greater blessings, ver.","sourceParagraph":1},{"verse":4,"text":"6-8.","sourceParagraph":1},{"verse":5,"text":"A psalm of David.","sourceParagraph":1},{"verse":6,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"The gods - Before kings and princes.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"Temple - Where the ark was.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"He was not permitted to enter into it.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":11,"text":"Magnified - For thou hast glorified thy word or promise unto me more than any other of thy glorious perfections.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"The kings - A prophecy of the calling of the Gentiles.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"Hear - The gospel preached among then.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":15,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":16,"text":"The ways - His wonderful counsel and gracious providences.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":17,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"Perfect - Will finish the great work of my deliverance.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":19,"text":"Forsake not - Or, do not give over, the work of my salvation, which is thus far advanced, not by any human help, but by thy power and providence.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":138}}