{"author":"John Wesley","book":"Notes on the Bible","chapter":844,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.107","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 107","reference":"Psalms 107","notes":[],"verses":[{"verse":1,"text":"The psalmist here observes God's providential care of the children of men in general, and shews how he helps those that are in any distress, in answer to their prayers.","sourceParagraph":1},{"verse":2,"text":"He instances in banishment and dispersion, ver.","sourceParagraph":1},{"verse":3,"text":"1-9.","sourceParagraph":1},{"verse":4,"text":"Captivity and imprisonment, ver.","sourceParagraph":1},{"verse":5,"text":"10-16.","sourceParagraph":1},{"verse":6,"text":"Sickness, ver.","sourceParagraph":1},{"verse":7,"text":"17-22.","sourceParagraph":1},{"verse":8,"text":"Distress at sea, ver.","sourceParagraph":1},{"verse":9,"text":"23-32.","sourceParagraph":1},{"verse":10,"text":"The disposal of families and nations, ver.","sourceParagraph":1},{"verse":11,"text":"33-13","sourceParagraph":1},{"verse":12,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":13,"text":"Gathered - Into their own land.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":14,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":15,"text":"No city - Or rather, no town inhabited, where they might refresh themselves.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":16,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"The Lord - Hebrew.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"Unto Jehovah, to the true God.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"For the Heathens had, many of them, some knowledge of the true God.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":20,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":21,"text":"Forth - Out of the wilderness.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":22,"text":"10.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":23,"text":"Darkness - In dark prisons or dungeons.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":24,"text":"12.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":25,"text":"Heart - The pride and obstinacy of their hearts.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":26,"text":"Fell - They fell into hopeless miseries.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":27,"text":"17.","sourceParagraph":8,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":28,"text":"Afflicted - With sickness.","sourceParagraph":8,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":29,"text":"20.","sourceParagraph":9,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":30,"text":"Word - His command, or blessing.","sourceParagraph":9,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":31,"text":"32.","sourceParagraph":10,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":32,"text":"Exalt him - In public assemblies, and before all persons, as they have opportunity.","sourceParagraph":10,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":33,"text":"Elders - The magistrates or rulers; let them not be ashamed nor afraid to speak of God's wonderful works, before the greatest of men.","sourceParagraph":10,"scriptureVerseStart":32,"scriptureVerseEnd":32},{"verse":34,"text":"33.","sourceParagraph":11,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":35,"text":"Rivers - Those grounds which are well watered, and therefore fruitful.","sourceParagraph":11,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":36,"text":"And so the water-springs, here, and the standing water, ver.","sourceParagraph":11,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":37,"text":"35 are taken.","sourceParagraph":11,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":38,"text":"Into - Into a dry ground, which is like a parched and barren wilderness.","sourceParagraph":11,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":39,"text":"34.","sourceParagraph":12,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":40,"text":"For - He doth not inflict these judgments without cause, but for the punishment of sin in some, and the prevention of it in others.","sourceParagraph":12,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":41,"text":"35.","sourceParagraph":13,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":42,"text":"Water - Into a well-watered and fruitful land.","sourceParagraph":13,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":43,"text":"36.","sourceParagraph":14,"scriptureVerseStart":36,"scriptureVerseEnd":36},{"verse":44,"text":"Hungry - Poor people who could not provide for themselves.","sourceParagraph":14,"scriptureVerseStart":36,"scriptureVerseEnd":36},{"verse":45,"text":"39.","sourceParagraph":15,"scriptureVerseStart":39,"scriptureVerseEnd":39},{"verse":46,"text":"They - These men, who when they are exalted by God, grow insolent and secure.","sourceParagraph":15,"scriptureVerseStart":39,"scriptureVerseEnd":39},{"verse":47,"text":"Low - By God's just judgment.","sourceParagraph":15,"scriptureVerseStart":39,"scriptureVerseEnd":39},{"verse":48,"text":"40.","sourceParagraph":16,"scriptureVerseStart":40,"scriptureVerseEnd":40},{"verse":49,"text":"Contempt - Renders them despicable.","sourceParagraph":16,"scriptureVerseStart":40,"scriptureVerseEnd":40},{"verse":50,"text":"Wander - Banishes them from their own courts and kingdoms, and forces them to flee into desolate wildernesses for shelter.","sourceParagraph":16,"scriptureVerseStart":40,"scriptureVerseEnd":40}],"scriptureReference":{"book":"Psalms","chapter":107}}