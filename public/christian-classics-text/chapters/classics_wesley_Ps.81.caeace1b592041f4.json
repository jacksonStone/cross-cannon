{"author":"John Wesley","book":"Notes on the Bible","chapter":818,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.81","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 81","reference":"Psalms 81","notes":[],"verses":[{"verse":1,"text":"This psalm may assist us in our solemn feast-days, in praising God, for what he is, and what he has done, ver.","sourceParagraph":1},{"verse":2,"text":"1-7.","sourceParagraph":1},{"verse":3,"text":"In admonishing one another, concerning our obligations to God, the danger of revolting from him, and the happiness of keeping close to him, ver.","sourceParagraph":1},{"verse":4,"text":"8-16.","sourceParagraph":1},{"verse":5,"text":"To the chief musician upon Gittith, A psalm of Asaph.","sourceParagraph":1},{"verse":6,"text":"5.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":7,"text":"Joseph - Among the people of Israel.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"Testimony - For a witness of that glorious deliverance.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"He - God.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"Went - As a captain at the head of his people.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"Egypt - To execute his judgments upon that land.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"I - My progenitors, for all the successive generations of Israel make one body, and are sometimes spoken of as one person.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"A language - The Egyptian language, which at first was unknown to the Israelites, Gen. xlii, 13, and probably continued so for some considerable time, because they were much separated both in place and conversation from the Egyptians.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"6.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"Pots - This word denotes all those vessels wherein they carried water, straw, lime, or bricks.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":17,"text":"Calledst - At the Red Sea.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"Secret place - From the dark and cloudy pillar, whence I thundered against the Egyptians.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":19,"text":"8.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":20,"text":"Testify - This God did presently after he brought them from Meribah, even at Sinai.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":21,"text":"10.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":22,"text":"Wide - Either to pray for mercies, or to receive the mercies which I am ready to give you.","sourceParagraph":6,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":23,"text":"15.","sourceParagraph":7,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":24,"text":"Him - Unto Israel.","sourceParagraph":7,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":25,"text":"Their time - Their happy time.","sourceParagraph":7,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":26,"text":"16.","sourceParagraph":8,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":27,"text":"Honey - With all pleasant and precious fruits.","sourceParagraph":8,"scriptureVerseStart":16,"scriptureVerseEnd":16}],"scriptureReference":{"book":"Psalms","chapter":81}}