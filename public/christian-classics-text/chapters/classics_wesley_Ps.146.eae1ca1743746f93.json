{"author":"John Wesley","book":"Notes on the Bible","chapter":883,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.146","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 146","reference":"Psalms 146","notes":[],"verses":[{"verse":1,"text":"The psalmist praises God, and exhorts all to trust in him alone, ver."},{"verse":2,"text":"1-5."},{"verse":3,"text":"Because of his power, faithfulness and everlasting kingdom, ver."},{"verse":4,"text":"6-10."},{"verse":5,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":6,"text":"That day - As soon as ever he is dead.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"Thoughts - All his designs and endeavours either for himself or for others.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":9,"text":"For ever - Both because he liveth forever to fulfil his promises, and because he is eternally faithful.","scriptureVerseStart":6,"scriptureVerseEnd":6}],"scriptureReference":{"book":"Psalms","chapter":146}}