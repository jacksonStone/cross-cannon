{"author":"John Wesley","book":"Notes on the Bible","chapter":406,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Num.29","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Numbers","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Numbers 29","reference":"Numbers 29","notes":[],"verses":[{"verse":1,"text":"Offerings to be made in the seventh month,","sourceParagraph":1},{"verse":2,"text":"1.","sourceParagraph":2},{"verse":3,"text":"At the feast of trumpets, ver.","sourceParagraph":2},{"verse":4,"text":"1-6.","sourceParagraph":2},{"verse":5,"text":"2.","sourceParagraph":3},{"verse":6,"text":"In the day of atonement, ver.","sourceParagraph":3},{"verse":7,"text":"7-11.","sourceParagraph":3},{"verse":8,"text":"3.","sourceParagraph":4},{"verse":9,"text":"At the feast of tabernacles, ver.","sourceParagraph":4},{"verse":10,"text":"12-40.","sourceParagraph":4},{"verse":11,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"Of the month - Belonging to every new moon.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"Afflict your souls - Yourselves, by fasting and abstinence from all delightful things, and by compunction for your sins, and the judgments of God, either deserved by you or inflicted upon you.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"12.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":16,"text":"Seven days - Not by abstaining so long from all servile work, but by offering extraordinary sacrifices each day.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":17,"text":"This was the Feast of Tabernacles.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":18,"text":"And all the days of their dwelling in booths, they must offer sacrifices.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":19,"text":"While we are in these tabernacles, 'tis our interest as well as duty, to keep up our communion with God.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":20,"text":"Nor will the unsettledness of our outward condition, excuse our neglect of God's worship.","sourceParagraph":7,"scriptureVerseStart":12,"scriptureVerseEnd":12}],"scriptureReference":{"book":"Numbers","chapter":29}}