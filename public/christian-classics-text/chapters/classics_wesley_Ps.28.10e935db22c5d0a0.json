{"author":"John Wesley","book":"Notes on the Bible","chapter":765,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.28","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 28","reference":"Psalms 28","notes":[],"verses":[{"verse":1,"text":"A prayer for help, ver."},{"verse":2,"text":"1-3."},{"verse":3,"text":"The doom of the wicked, ver."},{"verse":4,"text":"4, 5."},{"verse":5,"text":"A thanksgiving, closed with prayer, ver."},{"verse":6,"text":"6-9."},{"verse":7,"text":"A psalm of David."},{"verse":8,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"Towards - Towards the holy of holies, because there the ark was; from whence God gave oracular answers to his people.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"Draw not - Do not drag me; as thou dost these, to execution and destruction.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":12,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"Regard not - The providential works of God towards his people.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"I am helped - He speaks of it as past, because God assured him by his spirit, that he had heard and accepted his prayers.","scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Psalms","chapter":28}}