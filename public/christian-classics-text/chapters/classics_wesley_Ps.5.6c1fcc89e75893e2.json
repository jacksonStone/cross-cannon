{"author":"John Wesley","book":"Notes on the Bible","chapter":742,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.5","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 5","reference":"Psalms 5","notes":[],"verses":[{"verse":1,"text":"David beseeches God to hear his prayer, ver.","sourceParagraph":1},{"verse":2,"text":"1-3.","sourceParagraph":1},{"verse":3,"text":"Assures himself of God's justice against his enemies, ver.","sourceParagraph":1},{"verse":4,"text":"4-6.","sourceParagraph":1},{"verse":5,"text":"Declares his resolution: to serve God, ver.","sourceParagraph":1},{"verse":6,"text":"7.","sourceParagraph":1},{"verse":7,"text":"Prays for himself and the people of God, and against his enemies, ver.","sourceParagraph":1},{"verse":8,"text":"8-12.","sourceParagraph":1},{"verse":9,"text":"To the chief musician upon Nehiloth, A psalm of David.","sourceParagraph":1},{"verse":10,"text":"Title of the psalm.","sourceParagraph":1},{"verse":11,"text":"Nehiloth - This is no where else used in scripture.","sourceParagraph":1},{"verse":12,"text":"It is thought to signify a wind-instrument, as Neginoth signified stringed instruments.","sourceParagraph":1},{"verse":13,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":14,"text":"Meditation - My prayer accompanied with deep thoughts and fervent affections of soul.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":15,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":16,"text":"Morning - Every morning.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":17,"text":"As soon as I wake, I am still with thee, as he saith, chap.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":18,"text":"1xxxix, 18.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":19,"text":"The first thing that I do is to pray to thee.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":20,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":21,"text":"Surely - Thou dost not approve of, nor delight in them, or in their prayers.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":22,"text":"Dwelt - Have any fellowship with thee.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":23,"text":"7.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":24,"text":"Come - With holy boldness and confidence.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":25,"text":"Mercy - Trusting only in thy great mercy.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":26,"text":"Fear - With an holy dread and reverence of thy majesty.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":27,"text":"Towards - Looking towards it, when I cannot come to it.","sourceParagraph":5,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":28,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":29,"text":"Righteousness - In thy righteous laws.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":30,"text":"Because - That I may give them no occasion of slandering me, or religion for my sake.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":31,"text":"The way - The way wherein thou wouldst have to one walk.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":32,"text":"Plain - That I may clearly discern it, and readily walk in it.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":33,"text":"9.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":34,"text":"Throat - Wide opened ready to devour all that come within their reach.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":35,"text":"A metaphor from wild beasts gaping for the prey.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":36,"text":"10.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":37,"text":"Destroy - Condemn and punish them.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":38,"text":"Cast - Out of thy land, and from among thy people.","sourceParagraph":8,"scriptureVerseStart":10,"scriptureVerseEnd":10}],"scriptureReference":{"book":"Psalms","chapter":5}}