{"author":"John Wesley","book":"Notes on the Bible","chapter":835,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.98","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 98","reference":"Psalms 98","notes":[],"verses":[{"verse":1,"text":"This psalm sets forth the glory of the Redeemer, ver."},{"verse":2,"text":"1-3."},{"verse":3,"text":"And the joy of the redeemed, ver."},{"verse":4,"text":"4-9."},{"verse":5,"text":"A psalm."},{"verse":6,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"Salvation - The redemption of the world by the Messiah: which was hitherto reserved was a secret among the Jews, yea was not throughly known by the most of the Jews themselves.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"Righteousness - His faithfulness in accomplishing this great promise.","scriptureVerseStart":2,"scriptureVerseEnd":2}],"scriptureReference":{"book":"Psalms","chapter":98}}