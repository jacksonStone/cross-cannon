{"author":"Robert Jamieson, A. R. Fausset and David Brown","book":"Commentary Critical and Explanatory on the Whole Bible","chapter":613,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:jfb:Ps.135","lineage":[],"metadata":{"author":"Robert Jamieson, A. R. Fausset and David Brown","authorshipDateRange":"19th century","genre":"Commentaries","tradition":"Protestant","translator":null,"edition":"1871 one-volume text; expanded electronic edition by Ernie Stefanik","rights":"Public Domain","source":{"id":"jfb","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"searchIndexed":false},"originalBook":"Psalms","sourceVolumeId":"jfb","source":{"id":"jfb","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"title":"Psalms 135","reference":"Psalms 135","notes":[],"verses":[{"verse":1,"text":"PSALM 135","sourceParagraph":1},{"verse":2,"text":"Ps 135:1-21.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"A Psalm of praise, in which God's relations to His Church, His power in the natural world, and in delivering His people, are contrasted with the vanity of idols and idol-worship.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"1-3.","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"In the general call for praise, the priests, that stand in the house of the Lord, are specially mentioned.","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"4-7.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"God's choice of Israel is the first reason assigned for rendering praise; the next, His manifested greatness in creation and providence.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"6. heaven, and … seas, and all … ends of the earth—denote universality.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":9,"text":"8, 9.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":10,"text":"The last plague [Ex 12:29] is cited to illustrate His \"tokens and wonders.\"","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":11,"text":"10-12.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":12,"text":"The conquest of Canaan was by God's power, not that of the people.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":13,"text":"13. heritage—or, \"possession.\"","sourceParagraph":8,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":14,"text":"name … memorial—Each denote that by which God is made known.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":15,"text":"14. will judge—do justice (Ps 72:2).","sourceParagraph":10,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":16,"text":"repent himself—change His dealings (Ps 90:13).","sourceParagraph":11,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":17,"text":"15-18.","sourceParagraph":12,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":18,"text":"(Compare Ps 115:4-8).","sourceParagraph":12,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":19,"text":"18. are like unto them—or, \"shall be like,\" &c.","sourceParagraph":13,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":20,"text":"Idolaters become spiritually stupid and perish with their idols (Isa 1:31).","sourceParagraph":13,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":21,"text":"19-21.","sourceParagraph":14,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":22,"text":"(Compare Ps 115:9-11).","sourceParagraph":14,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":23,"text":"There we have \"trust\" for \"bless\" here.","sourceParagraph":14,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":24,"text":"21. out of Zion—(Compare Ps 110:2; 134:3).","sourceParagraph":15,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":25,"text":"From the Church, as a center, His praise is diffused throughout the earth.","sourceParagraph":15,"scriptureVerseStart":21,"scriptureVerseEnd":21}],"scriptureReference":{"book":"Psalms","chapter":135}}