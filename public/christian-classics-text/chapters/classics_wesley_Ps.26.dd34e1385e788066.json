{"author":"John Wesley","book":"Notes on the Bible","chapter":763,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.26","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 26","reference":"Psalms 26","notes":[],"verses":[{"verse":1,"text":"David professes his integrity, ver.","sourceParagraph":1},{"verse":2,"text":"1-8.","sourceParagraph":1},{"verse":3,"text":"Deprecates the doom of the wicked, ver.","sourceParagraph":1},{"verse":4,"text":"9, 10.","sourceParagraph":1},{"verse":5,"text":"Casts himself upon the mercy of God, ver.","sourceParagraph":1},{"verse":6,"text":"11, 12.","sourceParagraph":1},{"verse":7,"text":"A psalm of David.","sourceParagraph":1},{"verse":8,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"Trusted - I have committed my cause and affairs to thee.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":10,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"For - I dare appeal to thee, because thou knowest I have a deep sense of thy loving-kindness, by which I have been led to love and obey thee.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":12,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"Sat - Continued with them.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"I have been so far from an imitation of their wicked courses, that I have avoided their company.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":15,"text":"Vain - With false and deceitful persons.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":16,"text":"Go in - Into their company.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":17,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"Compass - Approach to thine altar with my sacrifices: which I could not do with any comfort, if I were conscious of those crimes, whereof mine enemies accuse me.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":20,"text":"House - Thy sanctuary and worship. honour - Thy glorious and gracious presence.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":21,"text":"9.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"Gather not - Do not bind me up in the same bundle, or put me into the same accursed condition with them.","sourceParagraph":7,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"12.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":24,"text":"Standeth - I stand upon a sure and solid foundation, being under the protection of God's promise, and his almighty and watchful providence.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":25,"text":"Congregations - I will not only privately, but in the assemblies of thy people celebrate thy praise.","sourceParagraph":8,"scriptureVerseStart":12,"scriptureVerseEnd":12}],"scriptureReference":{"book":"Psalms","chapter":26}}