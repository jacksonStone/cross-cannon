{"author":"John Wesley","book":"Notes on the Bible","chapter":894,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.7","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 7","reference":"Proverbs 7","notes":[],"verses":[{"verse":1,"text":"An exhortation to cleave to wisdom, as a preservative from strange women, ver.","sourceParagraph":1},{"verse":2,"text":"1-5.","sourceParagraph":1},{"verse":3,"text":"The snares they lay for unwary young men, ver.","sourceParagraph":1},{"verse":4,"text":"6-23.","sourceParagraph":1},{"verse":5,"text":"A serious caution against coming near them, ver.","sourceParagraph":1},{"verse":6,"text":"24-37.","sourceParagraph":1},{"verse":7,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"Live - Thou shalt live.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"Eye - With all possible care and diligence.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"Bind them - As a ring which is continually in a man's eye.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":12,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"And call - Acquaint and delight thyself with her.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"8.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":15,"text":"Passing - Idle and careless, near the corner of the street in which her house stood.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"12.","sourceParagraph":6,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":17,"text":"Without - Without the door of her house.","sourceParagraph":6,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":18,"text":"Corner - Of the streets, where she might either conceal or discover herself, as she saw fit.","sourceParagraph":6,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":19,"text":"14.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":20,"text":"Offerings - I have paid my peace-offerings which I had vowed.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":21,"text":"Whereby she signifies, that she had plentiful provisions at her house for his entertainment.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":22,"text":"For the peace-offerings were to be of the best flesh, Lev. xxii, 21, and a considerable part of these offerings fell to the offerer's share.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":23,"text":"20.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":24,"text":"Hath taken - Which is an evidence that he designs to stay a considerable time.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":25,"text":"At the day - So that we need not fear any surprise.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":26,"text":"22.","sourceParagraph":9,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":27,"text":"As an ox - Going to it securely, as if it were going to a good pasture.","sourceParagraph":9,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":28,"text":"23.","sourceParagraph":10,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":29,"text":"His liver - His vital parts, 'till his life be lost.","sourceParagraph":10,"scriptureVerseStart":23,"scriptureVerseEnd":23}],"scriptureReference":{"book":"Proverbs","chapter":7}}