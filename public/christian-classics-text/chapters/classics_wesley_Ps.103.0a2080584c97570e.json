{"author":"John Wesley","book":"Notes on the Bible","chapter":840,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.103","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 103","reference":"Psalms 103","notes":[],"verses":[{"verse":1,"text":"The psalmist stirs up himself to praise God for all his benefits, ver."},{"verse":2,"text":"1-19."},{"verse":3,"text":"Calls upon all his works to assist him therein, ver."},{"verse":4,"text":"20-22."},{"verse":5,"text":"A psalm of David."},{"verse":6,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":7,"text":"The eagles - Which lives long in great strength and vigour.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":8,"text":"11.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":9,"text":"So great - So much above their deserts and expectations.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":10,"text":"14.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":11,"text":"Knoweth - The weakness and mortality of our natures, and the frailty of our condition, so that if he should let loose his hand upon us, we should be irrecoverably destroyed.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":12,"text":"21.","scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":13,"text":"His hosts - A title often given to the angels, in regard of their vast numbers, mighty power, unanimous concurrence, and exquisite order.","scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":14,"text":"Ministers - This Hebrew word is commonly used of the highest and most honourable sort of servants,","scriptureVerseStart":21,"scriptureVerseEnd":21}],"scriptureReference":{"book":"Psalms","chapter":103}}