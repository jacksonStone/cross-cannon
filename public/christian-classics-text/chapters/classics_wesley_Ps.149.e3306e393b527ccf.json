{"author":"John Wesley","book":"Notes on the Bible","chapter":886,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.149","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 149","reference":"Psalms 149","notes":[],"verses":[{"verse":1,"text":"An exhortation to praise God for his love to his people, ver.","sourceParagraph":1},{"verse":2,"text":"1-5.","sourceParagraph":1},{"verse":3,"text":"And for enabling them to overcome their enemies, ver.","sourceParagraph":1},{"verse":4,"text":"6- 9.","sourceParagraph":1},{"verse":5,"text":"4.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":6,"text":"The Lord - He rejoiceth over them to do them good.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"Beautify - Hebrew. adorn, make them amiable and honourable in the eyes of the world, who now hate and despise them.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"The meek - All true Israelites are such.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"5.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"In glory - For the honour which God putteth upon them.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"Beds - By night as well as by day.","sourceParagraph":3,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"Vengeance - For all their cruelties and injuries towards God's people.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"This was literally accomplished by David upon the Philistines, Ammonites, Syrians and other neighbouring nations.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"9.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":16,"text":"Written - Appointed and declared in the holy scripture.","sourceParagraph":5,"scriptureVerseStart":9,"scriptureVerseEnd":9}],"scriptureReference":{"book":"Psalms","chapter":149}}