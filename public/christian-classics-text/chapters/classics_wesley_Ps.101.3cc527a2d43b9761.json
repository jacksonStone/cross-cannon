{"author":"John Wesley","book":"Notes on the Bible","chapter":838,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.101","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 101","reference":"Psalms 101","notes":[],"verses":[{"verse":1,"text":"This psalm was composed by David between the time of God's promising the kingdom to him and his actual possession of it.","sourceParagraph":1},{"verse":2,"text":"The general scope of David's vow, at his entrance on his government, ver.","sourceParagraph":1},{"verse":3,"text":"1, 2.","sourceParagraph":1},{"verse":4,"text":"The particulars of it, ver.","sourceParagraph":1},{"verse":5,"text":"3-8.","sourceParagraph":1},{"verse":6,"text":"A psalm of David.","sourceParagraph":1},{"verse":7,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"I will sing - I will praise thee, O Lord, for thy mercy and justice, which thou hast so eminently discovered in the government of the world, and of thy people; and I will make it my care to imitate thee herein.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"I will - I will manage all my affairs with wisdom and integrity.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":11,"text":"When - God is often said in scripture to come to men, when he fulfills a promise to them.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"House - In my court and family, as well as in my public administrations.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"Depart - Shall be turned out of my court.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":15,"text":"Know - Not own nor countenance.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":16,"text":"8.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"Early - Speedily; as soon as I am seated in the throne.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":101}}