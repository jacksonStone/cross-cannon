{"author":"John Wesley","book":"Notes on the Bible","chapter":866,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.129","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 129","reference":"Psalms 129","notes":[],"verses":[{"verse":1,"text":"The people of God commemorate their deliverance out of sore afflictions, ver."},{"verse":2,"text":"1-4."},{"verse":3,"text":"The destruction of their enemies, ver."},{"verse":4,"text":"5- 8."},{"verse":5,"text":"A song of degrees."},{"verse":6,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"From my youth - From the time that I was a people.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"Righteous - Faithful or merciful.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"The cords - Wherewith the plow was drawn.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"By these cords he understands all their plots and endeavours.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"House-tops - Which there were flat.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"Which - Having no deep root, never comes to maturity.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"And so all their designs shall be abortive.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"8.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"The blessing - Which was an usual salutation given by passengers to reapers: so the meaning is, it never continues 'till the harvest comes.","scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":129}}