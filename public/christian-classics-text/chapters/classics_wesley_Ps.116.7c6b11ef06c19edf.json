{"author":"John Wesley","book":"Notes on the Bible","chapter":853,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.116","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 116","reference":"Psalms 116","notes":[],"verses":[{"verse":1,"text":"This psalm is a solemn thanksgiving to God."},{"verse":2,"text":"Wherein the psalmist professes his love to God, for delivering him out of great straits and dangers, ver."},{"verse":3,"text":"1-8."},{"verse":4,"text":"Prays for his future protection, and promises to praise him, and to walk holy before him, 9-19."},{"verse":5,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"The sorrows - Dangerous and deadly calamities.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"Pains - Such agonies and horrors, as dying persons use to feel.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":9,"text":"Rest - Unto a chearful confidence in God.","scriptureVerseStart":7,"scriptureVerseEnd":7}],"scriptureReference":{"book":"Psalms","chapter":116}}