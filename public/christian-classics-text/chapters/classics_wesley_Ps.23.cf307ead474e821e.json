{"author":"John Wesley","book":"Notes on the Bible","chapter":760,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.23","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 23","reference":"Psalms 23","notes":[],"verses":[{"verse":1,"text":"David extolls the goodness of God as his shepherd, and expresses his confidence in him, ver.","sourceParagraph":1},{"verse":2,"text":"1-6.","sourceParagraph":1},{"verse":3,"text":"A psalm of David.","sourceParagraph":1},{"verse":4,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"Lie down - To repose myself at noon, as the manner was in those hot countries.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"Green - Where there is both delight and plenty of provisions.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"Restoreth - Hebrew.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"He bringeth it back; from its errors and wandering.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"For - Not for any worth in me, but for the glory of his justice, and faithfulness, and goodness.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"Thy rod and thy staff - Two words denoting the same thing, and both designing God's pastoral care over him.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"A table - Thou furnishest me with plenty of provisions and comforts.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"Oil - With aromatic ointments, which were then used at great feasts; thy comforts delight my soul.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":16,"text":"Runneth over - Thou hast given me a plentiful portions, signified by the cup, given to the guests by the master of the feast.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5}],"scriptureReference":{"book":"Psalms","chapter":23}}