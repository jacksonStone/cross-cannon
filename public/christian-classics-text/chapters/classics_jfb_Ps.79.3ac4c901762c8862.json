{"author":"Robert Jamieson, A. R. Fausset and David Brown","book":"Commentary Critical and Explanatory on the Whole Bible","chapter":557,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:jfb:Ps.79","lineage":[],"metadata":{"author":"Robert Jamieson, A. R. Fausset and David Brown","authorshipDateRange":"19th century","genre":"Commentaries","tradition":"Protestant","translator":null,"edition":"1871 one-volume text; expanded electronic edition by Ernie Stefanik","rights":"Public Domain","source":{"id":"jfb","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"searchIndexed":false},"originalBook":"Psalms","sourceVolumeId":"jfb","source":{"id":"jfb","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"title":"Psalms 79","reference":"Psalms 79","notes":[],"verses":[{"verse":1,"text":"PSALM 79","sourceParagraph":1},{"verse":2,"text":"Ps 79:1-13.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"This Psalm, like the seventy-fourth, probably depicts the desolations of the Chaldeans (Jer 52:12-24).","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"It comprises the usual complaint, prayer, and promised thanks for relief.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"1.","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"(Compare Ps 74:2-7).","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"2, 3.","sourceParagraph":4,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"(Compare Jer 15:3; 16:4).","sourceParagraph":4,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"4.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"(Compare Ps 44:13; Jer 42:18; La 2:15).","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"5.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"How long—(Ps 13:1).","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"be angry—(Ps 74:1-10).","sourceParagraph":7,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"jealousy burn—(De 29:20).","sourceParagraph":8,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":15,"text":"6, 7.","sourceParagraph":9,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"(Compare Jer 10:25).","sourceParagraph":9,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"Though we deserve much, do not the heathen deserve more for their violence to us (Jer 51:3-5; Zec 1:14)?","sourceParagraph":9,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":18,"text":"The singular denotes the chief power, and the use of the plural indicates the combined confederates.","sourceParagraph":9,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":19,"text":"called upon—or, \"by\"","sourceParagraph":10,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":20,"text":"thy name—proclaimed Thy attributes and professed allegiance (Isa 12:4; Ac 2:21).","sourceParagraph":11,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":21,"text":"8. former iniquities—literally, \"iniquities of former times.\"","sourceParagraph":12,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":22,"text":"prevent us—literally, \"meet us,\" as in Ps 21:3.","sourceParagraph":13,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":23,"text":"9. for … glory of thy name [and for] thy name's sake—both mean for illustrating Thy attributes, faithfulness, power, &c.","sourceParagraph":14,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":24,"text":"purge … sins—literally, \"provide atonement for us.\"","sourceParagraph":15,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":25,"text":"Deliverance from sin and suffering, for their good and God's glory, often distinguish the prayers of Old Testament saints (compare Eph 1:7).","sourceParagraph":15,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":26,"text":"10.","sourceParagraph":16,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":27,"text":"This ground of pleading often used (Ex 32:12; Nu 14:13-16).","sourceParagraph":16,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":28,"text":"blood … shed—(Ps 79:3).","sourceParagraph":17,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":29,"text":"11. prisoner—the whole captive people.","sourceParagraph":18,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":30,"text":"power—literally, \"arm\" (Ps 10:15).","sourceParagraph":19,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":31,"text":"12. into their bosom—The lap or folds of the dress is used by Eastern people for receiving articles.","sourceParagraph":20,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":32,"text":"The figure denotes retaliation (compare Isa 65:6, 7).","sourceParagraph":20,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":33,"text":"They reproached God as well as His people.","sourceParagraph":20,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":34,"text":"13. sheep … pasture—(Compare Ps 74:1; 78:70).","sourceParagraph":21,"scriptureVerseStart":13,"scriptureVerseEnd":13}],"scriptureReference":{"book":"Psalms","chapter":79}}