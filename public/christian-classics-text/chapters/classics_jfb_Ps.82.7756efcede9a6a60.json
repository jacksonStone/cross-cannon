{"author":"Robert Jamieson, A. R. Fausset and David Brown","book":"Commentary Critical and Explanatory on the Whole Bible","chapter":560,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:jfb:Ps.82","lineage":[],"metadata":{"author":"Robert Jamieson, A. R. Fausset and David Brown","authorshipDateRange":"19th century","genre":"Commentaries","tradition":"Protestant","translator":null,"edition":"1871 one-volume text; expanded electronic edition by Ernie Stefanik","rights":"Public Domain","source":{"id":"jfb","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"searchIndexed":false},"originalBook":"Psalms","sourceVolumeId":"jfb","source":{"id":"jfb","sourceUrl":"https://www.ccel.org/ccel/jamieson/jfb.html","title":"Commentary Critical and Explanatory on the Whole Bible"},"title":"Psalms 82","reference":"Psalms 82","notes":[],"verses":[{"verse":1,"text":"PSALM 82","sourceParagraph":1},{"verse":2,"text":"Ps 82:1-8.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"Before the great Judge, the judges of the earth are rebuked, exhorted, and threatened.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":4,"text":"1. congregation—(Compare Ex 12:3; 16:1).","sourceParagraph":3,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"of the mighty—that is, of God, of His appointment.","sourceParagraph":4,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"the gods—or, \"judges\" (Ex 21:6; 22:9), God's representatives.","sourceParagraph":5,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"2. accept the persons—literally, \"lift up the faces,\" that is, from dejection, or admit to favor and communion, regardless of merit (Le 19:15; Pr 18:5).","sourceParagraph":6,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"3, 4.","sourceParagraph":7,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"So must good judges act (Ps 10:14; Job 29:12).","sourceParagraph":7,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"4. poor and needy—(Compare Ps 34:10; 41:1).","sourceParagraph":8,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"5.","sourceParagraph":9,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"By the wilful ignorance and negligence of judges, anarchy ensues (Ps 11:3; 75:3).","sourceParagraph":9,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"out of course—(Compare Margin; Ps 9:6; 62:2).","sourceParagraph":10,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":14,"text":"6, 7.","sourceParagraph":11,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"Though God admitted their official dignity (Joh 10:34), He reminds them of their mortality.","sourceParagraph":11,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"7. fall like, &c.—be cut off suddenly (Ps 20:8; 91:7).","sourceParagraph":12,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":17,"text":"8.","sourceParagraph":13,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"As rightful sovereign of earth, God is invoked personally to correct the evils of His representatives.","sourceParagraph":13,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":82}}