{"author":"John Wesley","book":"Notes on the Bible","chapter":1032,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Jer.28","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Jeremiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Jeremiah 28","reference":"Jeremiah 28","notes":[],"verses":[{"verse":1,"text":"Hananiah's false prophecy: Jeremiah's answer, ver.","sourceParagraph":1},{"verse":2,"text":"1-9.","sourceParagraph":1},{"verse":3,"text":"Hananiah breaks Jeremiah's yoke: he foretells an iron yoke, and Hananiah's death, ver.","sourceParagraph":1},{"verse":4,"text":"10-17.","sourceParagraph":1},{"verse":5,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"The fourth year - Perhaps the fourth year of the sabbatical course is here intended.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Of Gibeon - it is probable from the place where he lived, which was one of the cities of the priests; that he was a priest.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"12.","sourceParagraph":3,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":9,"text":"Then - Some time after.","sourceParagraph":3,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":10,"text":"13.","sourceParagraph":4,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":11,"text":"But - Thou hast further incensed God against them, and provoked him to make their judgment heavier.","sourceParagraph":4,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":12,"text":"17.","sourceParagraph":5,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":13,"text":"Died - Within two months after Jeremiah had thus prophesied; so dangerous a thing it is for ministers to teach people contrary to the revealed will of God.","sourceParagraph":5,"scriptureVerseStart":17,"scriptureVerseEnd":17}],"scriptureReference":{"book":"Jeremiah","chapter":28}}