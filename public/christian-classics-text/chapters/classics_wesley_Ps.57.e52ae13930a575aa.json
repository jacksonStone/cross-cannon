{"author":"John Wesley","book":"Notes on the Bible","chapter":794,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.57","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 57","reference":"Psalms 57","notes":[],"verses":[{"verse":1,"text":"David here begins with prayer and complaint, tho' not as without hope, ver."},{"verse":2,"text":"1-6."},{"verse":3,"text":"He concludes with joy and praise, ver."},{"verse":4,"text":"7- 11."},{"verse":5,"text":"To the chief musician Al-taschith, Michtam of David, when he fled from Saul in the cave."},{"verse":6,"text":"Title of the psalm."},{"verse":7,"text":"Al-taschith - The word signifies, destroy not."},{"verse":8,"text":"Which some think to be a preface, containing the sum of the psalm."},{"verse":9,"text":"The cave - Either"},{"verse":10,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"That of Adullam, 1 Sam. xxii, 1, or","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":12,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"That of Engedi, 1 Sam. xxiv, 1.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":14,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":15,"text":"Send forth - Will discover them, by affording his gracious help in pursuance of his promises.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":16,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":17,"text":"Lions - Fierce and bloody men.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":18,"text":"I lie - I have my abode.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":19,"text":"On fire - From hell.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":20,"text":"Who are mere fire-brands, breathing out wrath and threatenings, and incensing Saul against me.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":21,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":22,"text":"Excited - Glorify thy power, and goodness, and justice, and faithfulness, by my deliverance.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":23,"text":"Above, &c. - To the highest degree possible.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":24,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":25,"text":"Fixed - In a stedfast belief of thy promises.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":26,"text":"8.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":27,"text":"My glory - My tongue, the instrument of singing.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":28,"text":"Awake - I will employ all the powers of my soul and body.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":29,"text":"9.","scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":30,"text":"The people - Among the Israelites, and among the Heathens, as I shall have occasion.","scriptureVerseStart":9,"scriptureVerseEnd":9}],"scriptureReference":{"book":"Psalms","chapter":57}}