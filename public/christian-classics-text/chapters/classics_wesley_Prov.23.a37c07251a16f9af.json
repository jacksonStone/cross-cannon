{"author":"John Wesley","book":"Notes on the Bible","chapter":910,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.23","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 23","reference":"Proverbs 23","notes":[],"verses":[{"verse":1,"text":"1.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":2,"text":"Ruler - With a great man.","sourceParagraph":1,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":3,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":4,"text":"Put a knife - Restrain thine appetite, as if a man stood with a knife at thy throat.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":6,"text":"Deceitful - They do not yield thee that satisfaction which thou didst expect from them.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"Thine own wisdom - From worldly wisdom, which persuades men to use all possible means to get riches.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"Set thine eyes - Look upon it with earnestness and desire.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"Is not - Which has no solid and settled being.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"Eagle - Swiftly, strongly, and irrecoverably.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"6.","sourceParagraph":6,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"Evil eye - Of the envious or covetous man.","sourceParagraph":6,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"7.","sourceParagraph":7,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":16,"text":"So is he - You are not to judge of him by his words, but by the constant temper of his mind.","sourceParagraph":7,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":17,"text":"8.","sourceParagraph":8,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"Vomit up - When thou perceivest his churlish disposition, his meat will be loathsome to thee.","sourceParagraph":8,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":19,"text":"Sweet words - Thy pleasant discourse wherewith thou didst design to delight and profit him.","sourceParagraph":8,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":20,"text":"9.","sourceParagraph":9,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":21,"text":"Of a fool - Cast not away good counsels upon incorrigible sinners.","sourceParagraph":9,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"10.","sourceParagraph":10,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":23,"text":"Enter not - To possess their lands.","sourceParagraph":10,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":24,"text":"11.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":25,"text":"Redeemer - Hebrew. their near kinsman, to whom it belongs to avenge their wrongs, and to recover and maintain their rights.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":26,"text":"13.","sourceParagraph":12,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":27,"text":"Shall not die - It is a likely way to prevent his destruction.","sourceParagraph":12,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":28,"text":"16.","sourceParagraph":13,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":29,"text":"My reins - I shall rejoice with all my soul.","sourceParagraph":13,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":30,"text":"18.","sourceParagraph":14,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":31,"text":"An end - An expected and happy end for such as fear God.","sourceParagraph":14,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":32,"text":"19.","sourceParagraph":15,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":33,"text":"Guide - Order the whole course of thine affections and actions.","sourceParagraph":15,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":34,"text":"In the way - In God's way.","sourceParagraph":15,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":35,"text":"23.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":36,"text":"Buy - Purchase it upon any terms, spare no pains or cost.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":37,"text":"Truth - The true and saving knowledge of God's will.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":38,"text":"Sell it not - Do not forsake it for any worldly advantage.","sourceParagraph":16,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":39,"text":"26.","sourceParagraph":17,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":40,"text":"Give me - Solomon here speaks in God's name.","sourceParagraph":17,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":41,"text":"30.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":42,"text":"Mixt wine - Either mixed with water, or with other ingredients to make it strong and delicious.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":43,"text":"31.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":44,"text":"Red - Which was the colour of the best wines in that country.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":45,"text":"Aright - When it sparkles, and seems to smile upon a man.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":46,"text":"34.","sourceParagraph":20,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":47,"text":"Lieth down - To sleep.","sourceParagraph":20,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":48,"text":"Sea - In a ship in the midst of the sea.","sourceParagraph":20,"scriptureVerseStart":34,"scriptureVerseEnd":34},{"verse":49,"text":"35.","sourceParagraph":21,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":50,"text":"Sick - I was not sensible of it.","sourceParagraph":21,"scriptureVerseStart":35,"scriptureVerseEnd":35},{"verse":51,"text":"Again - At present my condition requires sleep to settle myself, and when I am composed, I purpose to return to my former course.","sourceParagraph":21,"scriptureVerseStart":35,"scriptureVerseEnd":35}],"scriptureReference":{"book":"Proverbs","chapter":23}}