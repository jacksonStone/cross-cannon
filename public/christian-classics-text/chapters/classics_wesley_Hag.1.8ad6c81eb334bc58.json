{"author":"John Wesley","book":"Notes on the Bible","chapter":1169,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Hag.1","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Haggai","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Haggai 1","reference":"Haggai 1","notes":[],"verses":[{"verse":1,"text":"A reproof of the Jews for their delay in building, which had provoked God to punish them, ver.","sourceParagraph":1},{"verse":2,"text":"1-11.","sourceParagraph":1},{"verse":3,"text":"The peoples return to the work, whom the prophet, in God's name, encourages therein, ver.","sourceParagraph":1},{"verse":4,"text":"12-15.","sourceParagraph":1},{"verse":5,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"Son - Adoptive son to Shealtiel, being of the royal line, but by nature, son of Pedaiah.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Governor - Appointed to this by the Persian king, over the remnant returned out of Babylon.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"Joshua - A type of the great deliverer; one Joshua leads them into Canaan, another restores the temple.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"4.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":10,"text":"Ceiled - Arched and richly adorned.","sourceParagraph":3,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"6.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"Have not enough - But what you eat doth not nourish or satisfy you.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"Are not filled - Your water quenches not your thirst, your wine does not revive your spirit.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"None warm - You have no comfort therein.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"With holes - Loses all his labour.","sourceParagraph":4,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"8.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"Take pleasure - I will accept your offerings, and hear your prayers.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"Glorified - Shew my majesty and account myself glorified by you also.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":19,"text":"9.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":20,"text":"Came to little - But it answered not the expectation.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":21,"text":"I did blow - I blasted it.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":22,"text":"Ye run - You with eagerness carry on your own particular buildings.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"10.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":24,"text":"Is stayed - God hath forbidden them, to drop down dew.","sourceParagraph":7,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":25,"text":"11.","sourceParagraph":8,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":26,"text":"Upon men - The very blood, and constitutions of men were changed, and many diseases afflicted them.","sourceParagraph":8,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":27,"text":"13.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":28,"text":"In the Lord's message - ln the words of his master.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":29,"text":"The people - The whole assembly.","sourceParagraph":9,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":30,"text":"14.","sourceParagraph":10,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":31,"text":"The Lord of hosts - By which name he delights to be known among the returned captives; and it was a name best suited to their present state, compassed on all hands with enemies.","sourceParagraph":10,"scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Haggai","chapter":1}}