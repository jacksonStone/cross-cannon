{"author":"John Wesley","book":"Notes on the Bible","chapter":819,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.82","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 82","reference":"Psalms 82","notes":[],"verses":[{"verse":1,"text":"We have here the dignity and duty of magistrates, ver.","sourceParagraph":1},{"verse":2,"text":"1-4.","sourceParagraph":1},{"verse":3,"text":"The wickedness of some magistrates, and their doom, ver.","sourceParagraph":1},{"verse":4,"text":"5-7.","sourceParagraph":1},{"verse":5,"text":"A prayer to God, ver.","sourceParagraph":1},{"verse":6,"text":"8.","sourceParagraph":1},{"verse":7,"text":"A psalm of Asaph.","sourceParagraph":1},{"verse":8,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":9,"text":"Standeth - To observe all that is said or done there.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":10,"text":"Mighty - Kings or chief rulers.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"By their congregation he understands all persons whatsoever of this high and sacred order.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":12,"text":"Judgeth - Passes sentence upon them.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":13,"text":"The gods - Judges and magistrates are called gods, because they have their commission from God, and act as his deputies.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":14,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":15,"text":"How long - The psalmist speaks to them in God's name.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":16,"text":"Accept - By giving sentence according to your respect or affection to the person.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":17,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":18,"text":"They - The magistrates of whom this psalm treats.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":19,"text":"Know not - The duty of their place.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":20,"text":"Nor will - Their ignorance is wilful.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":21,"text":"Walk on - They persist: it is their constant course.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":22,"text":"In darkness - In their sinful courses.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":23,"text":"The foundations - This corruption of the supreme rulers, flows from them to their inferior officers and members.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":24,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":25,"text":"Have said - I have given you my name and power to rule your people in my stead.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":26,"text":"All - Not only the rulers of Israel, but of all other nations.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":27,"text":"Children - Representing my person, and bearing both my name and authority.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":28,"text":"7.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":29,"text":"Like men - Or, like ordinary men.","sourceParagraph":6,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":30,"text":"8.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":31,"text":"Arise - Take the sword of justice into thine own hand.","sourceParagraph":7,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":82}}