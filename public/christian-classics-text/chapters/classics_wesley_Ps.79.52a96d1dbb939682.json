{"author":"John Wesley","book":"Notes on the Bible","chapter":816,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.79","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 79","reference":"Psalms 79","notes":[],"verses":[{"verse":1,"text":"This psalm seems to have been written by the later Asaph, upon the destruction of Jerusalem by the Chaldeans.","sourceParagraph":1},{"verse":2,"text":"It contains, a representation of the deplorable condition of the Jews, ver.","sourceParagraph":1},{"verse":3,"text":"1-5.","sourceParagraph":1},{"verse":4,"text":"And a petition for deliverance, ver.","sourceParagraph":1},{"verse":5,"text":"6-13.","sourceParagraph":1},{"verse":6,"text":"A psalm of Asaph.","sourceParagraph":1},{"verse":7,"text":"8.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":8,"text":"Prevent - Prevent our utter extirpation.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":9,"text":"11.","sourceParagraph":3,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":10,"text":"The prisoner - Of thy poor people now in captivity.","sourceParagraph":3,"scriptureVerseStart":11,"scriptureVerseEnd":11}],"scriptureReference":{"book":"Psalms","chapter":79}}