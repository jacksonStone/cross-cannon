{"author":"John Wesley","book":"Notes on the Bible","chapter":834,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.97","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 97","reference":"Psalms 97","notes":[],"verses":[{"verse":1,"text":"Christ is the Alpha and Omega in this psalm."},{"verse":2,"text":"His government speaks terror to his enemies, ver."},{"verse":3,"text":"1-7."},{"verse":4,"text":"And comfort to his friends, whom he preserves and delivers, ver."},{"verse":5,"text":"8-12."},{"verse":6,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"Isles - The Gentile nations, as this word, used Isaiah xlii, 4, is expounded, Matt. xii, 21.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":9,"text":"Darkness - A dark cloud doth encompass him.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":10,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"Heavens - The angels, yea God himself from heaven.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":12,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"Confounded - Let them be ashamed of their folly.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":14,"text":"Gods - All you whom the Gentiles have made the objects of their worship.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"8.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"Zion - Thy people dwelling in Zion or Jerusalem, to whom Christ came.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"Heard - The fame of thy judgments, and the setting up the kingdom of the Messiah.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":18,"text":"11.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":19,"text":"Light - Joy and happiness.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":20,"text":"Sown - Is laid up for them.","scriptureVerseStart":11,"scriptureVerseEnd":11}],"scriptureReference":{"book":"Psalms","chapter":97}}