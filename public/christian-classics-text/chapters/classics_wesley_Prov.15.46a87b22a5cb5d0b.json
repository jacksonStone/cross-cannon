{"author":"John Wesley","book":"Notes on the Bible","chapter":902,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.15","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 15","reference":"Proverbs 15","notes":[],"verses":[{"verse":1,"text":"2.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":2,"text":"Aright - Expressing what he knows prudently and gracefully.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":3,"text":"Poureth out - Plentifully, continually, and vehemently, as a fountain does waters.","sourceParagraph":1,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":4,"text":"4.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":5,"text":"Wholesome - Which utters sound and useful counsels.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":6,"text":"Tree of life - Is greatly useful to preserve the present life, and to promote the spiritual and eternal life, both of the speaker and hearers.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":7,"text":"Perverseness - False or corrupt speeches.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":8,"text":"A breach - Disturbs and wounds the spirits, both of the speaker and hearers.","sourceParagraph":2,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":9,"text":"6.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":10,"text":"Revenues - Though he may obtain great revenues, yet they are attended with much trouble.","sourceParagraph":3,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":11,"text":"7.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":12,"text":"Disperse - Freely communicate to others what they know.","sourceParagraph":4,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":13,"text":"8.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":14,"text":"Sacrifice - All the religious services, yea, the most costly; one kind being put for all the rest.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":15,"text":"Prayer - The cheapest and meanest services.","sourceParagraph":5,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"11.","sourceParagraph":6,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":17,"text":"Destruction - The place of destruction, of which men know nothing but by Divine Revelation.","sourceParagraph":6,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":18,"text":"14.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":19,"text":"Foolishness - Wickedness is meat and drink to them.","sourceParagraph":7,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":20,"text":"15.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":21,"text":"Afflicted - Of the troubled in mind.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":22,"text":"Evil - Tedious and uncomfortable.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":23,"text":"Chearful - Hebrew. of a good heart.","sourceParagraph":8,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":24,"text":"16.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":25,"text":"Trouble - Tumultuous lusts and passions, vexatious cares, and horrors of conscience.","sourceParagraph":9,"scriptureVerseStart":16,"scriptureVerseEnd":16},{"verse":26,"text":"19.","sourceParagraph":10,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":27,"text":"An hedge - As a way hedged up with thorns, troublesome, perplexed, and full of difficulties.","sourceParagraph":10,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":28,"text":"Plain - Is easy and pleasant to him, notwithstanding all its difficulties.","sourceParagraph":10,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":29,"text":"22.","sourceParagraph":11,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":30,"text":"Counsel - When men do not seek, or will not receive advice from others.","sourceParagraph":11,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":31,"text":"23.","sourceParagraph":12,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":32,"text":"The answer - By a wise, or good and seasonable answer.","sourceParagraph":12,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":33,"text":"24.","sourceParagraph":13,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":34,"text":"The way - The way a wise man takes to obtain life, is to place his heart, and treasure, and conversation on things above.","sourceParagraph":13,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":35,"text":"25.","sourceParagraph":14,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":36,"text":"The proud - Of the mighty oppressors.","sourceParagraph":14,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":37,"text":"The border - The estate, the border being often used, for the land within the borders.","sourceParagraph":14,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":38,"text":"26.","sourceParagraph":15,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":39,"text":"Pleasant - Acceptable to God.","sourceParagraph":15,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":40,"text":"27.","sourceParagraph":16,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":41,"text":"Troubleth - Brings God's curse upon himself and family.","sourceParagraph":16,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":42,"text":"Gifts - Bribes given to corrupt judgment.","sourceParagraph":16,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":43,"text":"Live - Shall preserve himself and family from ruin.","sourceParagraph":16,"scriptureVerseStart":27,"scriptureVerseEnd":27},{"verse":44,"text":"28.","sourceParagraph":17,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":45,"text":"Studieth - He speaks considerately.","sourceParagraph":17,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":46,"text":"The mouth - Not the heart; for he rashly speaks what comes into his mouth, without the direction of his heart or conscience.","sourceParagraph":17,"scriptureVerseStart":28,"scriptureVerseEnd":28},{"verse":47,"text":"30.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":48,"text":"A good report - A good name.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":49,"text":"Fat - Not only chears a man for the present, but gives him such stable comfort as revives his soul, and gives vigour to his body.","sourceParagraph":18,"scriptureVerseStart":30,"scriptureVerseEnd":30},{"verse":50,"text":"31.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":51,"text":"The ear - The man that hearkens to that reproof which leads to life, seeks and delights in the company of the wise.","sourceParagraph":19,"scriptureVerseStart":31,"scriptureVerseEnd":31},{"verse":52,"text":"33.","sourceParagraph":20,"scriptureVerseStart":33,"scriptureVerseEnd":33},{"verse":53,"text":"The instruction - Doth instruct men in true wisdom.","sourceParagraph":20,"scriptureVerseStart":33,"scriptureVerseEnd":33}],"scriptureReference":{"book":"Proverbs","chapter":15}}