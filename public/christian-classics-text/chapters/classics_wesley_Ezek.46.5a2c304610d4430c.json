{"author":"John Wesley","book":"Notes on the Bible","chapter":1107,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ezek.46","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Ezekiel","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Ezekiel 46","reference":"Ezekiel 46","notes":[],"verses":[{"verse":1,"text":"Farther rules for the worship of the priests and the people, ver.","sourceParagraph":1},{"verse":2,"text":"1-15.","sourceParagraph":1},{"verse":3,"text":"A rule, for the prince's disposal of his inheritance, ver.","sourceParagraph":1},{"verse":4,"text":"16-18.","sourceParagraph":1},{"verse":5,"text":"A description of the places for the boiling and baking the offerings, ver.","sourceParagraph":1},{"verse":6,"text":"19-24.","sourceParagraph":1},{"verse":7,"text":"3.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"In the sabbaths - Both weekly and other holy days, which are called sabbaths.","sourceParagraph":2,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"9.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":10,"text":"Go forth over against it - Perhaps, only to prevent all jostling and confusion.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":11,"text":"17.","sourceParagraph":4,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":12,"text":"His inheritance - Whatever lands of the prince are given to servants, shall at the year of Jubilee revert to the sons of the prince.","sourceParagraph":4,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":13,"text":"For them - And to theirs after them.","sourceParagraph":4,"scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":14,"text":"20.","sourceParagraph":5,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":15,"text":"The outer court - Where the people were.","sourceParagraph":5,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":16,"text":"21.","sourceParagraph":6,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":17,"text":"A court - A smaller court made up on the outer sides with the walls of the greater square, and on the inside made with two walls, the one forty cubits long, the other thirty cubits broad.","sourceParagraph":6,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":18,"text":"23.","sourceParagraph":7,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":19,"text":"A row of building - A range of building on the inside of the walls of the lesser courts.","sourceParagraph":7,"scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":20,"text":"Four - Four courts in the four corners.","sourceParagraph":7,"scriptureVerseStart":23,"scriptureVerseEnd":23}],"scriptureReference":{"book":"Ezekiel","chapter":46}}