{"author":"John Wesley","book":"Notes on the Bible","chapter":874,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.137","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 137","reference":"Psalms 137","notes":[],"verses":[{"verse":1,"text":"Probably this psalm was wrote toward the end of the Babylonish captivity."},{"verse":2,"text":"Herein the captives complain of the scoffs of their enemies, yet remember Jerusalem, and foresee the downfall of Babylon, ver."},{"verse":3,"text":"1-9."},{"verse":4,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":5,"text":"Sat - The usual posture of mourners.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":6,"text":"2.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":7,"text":"Harps - Harps are here put for all instruments of musick.","scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":8,"text":"3.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"A song - Such songs as you used to sing in the temple of Zion.","scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":11,"text":"The Lord's - Those songs which were appointed by God to be sung only in his service.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":13,"text":"If - If I do not value Jerusalem's prosperity more than all other delights.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":15,"text":"The day - In the time of its destruction.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":16,"text":"8.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":17,"text":"Happy - As being God's instrument to vindicate his honour, and execute his just judgments.","scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":137}}