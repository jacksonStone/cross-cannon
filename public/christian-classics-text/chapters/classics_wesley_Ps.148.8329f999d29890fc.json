{"author":"John Wesley","book":"Notes on the Bible","chapter":885,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.148","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 148","reference":"Psalms 148","notes":[],"verses":[{"verse":1,"text":"An exhortation to all creatures in heaven and earth, man especially, to praise God, ver."},{"verse":2,"text":"1-14."},{"verse":3,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":4,"text":"Heavens of heavens - Ye highest heavens, the place of God's throne.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":5,"text":"Waters - Ye clouds which are above a part of the heavens.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":6,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":7,"text":"Established - He hath made them constant and incorruptible, not changeable, as the things of the lower world.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":8,"text":"A decree - Concerning their continuance.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":9,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":10,"text":"Dragons - Either serpents, which hide in the deep caverns of the earth; or whales, and other sea-monsters, which dwell in the depths of the sea.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":11,"text":"8.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":12,"text":"Fire - Lightnings and other fireworks of the air.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":13,"text":"Vapor - Or, fumes: hot exhalations.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":14,"text":"Fulfilling his word - Executing his commands, either for the comfort or punishment of the inhabitants of the earth.","scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":15,"text":"13.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":16,"text":"Above - Above all the glories which are in earth and in heaven.","scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":17,"text":"14.","scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":18,"text":"The horn - In scripture commonly denotes strength, victory, glory, and felicity.","scriptureVerseStart":14,"scriptureVerseEnd":14}],"scriptureReference":{"book":"Psalms","chapter":148}}