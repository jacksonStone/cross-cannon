{"author":"John Wesley","book":"Notes on the Bible","chapter":616,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:1Chr.19","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"1 Chronicles","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"1 Chronicles 19","reference":"1 Chronicles 19","notes":[],"verses":[{"verse":1,"text":"David's friendly message to king Hanun, ver.","sourceParagraph":1},{"verse":2,"text":"1, 2.","sourceParagraph":1},{"verse":3,"text":"Hanun's base usage of his ambassadors, ver.","sourceParagraph":1},{"verse":4,"text":"3-5.","sourceParagraph":1},{"verse":5,"text":"The Ammonites prepare for war, ver.","sourceParagraph":1},{"verse":6,"text":"6, 7.","sourceParagraph":1},{"verse":7,"text":"David overthrows them and the Syrians, ver.","sourceParagraph":1},{"verse":8,"text":"8- 19.","sourceParagraph":1},{"verse":9,"text":"7.","sourceParagraph":2,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":10,"text":"Chariots - Thirty two thousand men, who fought partly from chariots, and partly on foot with chariots, or attending upon the chariots, as the ancient manner of fighting was.","sourceParagraph":2,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":11,"text":"19.","sourceParagraph":3,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":12,"text":"His servants - Let those who have in vain stood it out against God, be thus wise