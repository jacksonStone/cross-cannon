{"author":"John Wesley","book":"Notes on the Bible","chapter":846,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.109","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 109","reference":"Psalms 109","notes":[],"verses":[{"verse":1,"text":"David complains of his enemies and appeals to God, ver."},{"verse":2,"text":"1-5."},{"verse":3,"text":"Foretells their destruction, ver."},{"verse":4,"text":"6-20."},{"verse":5,"text":"Prays that God would succor him in his low condition, ver."},{"verse":6,"text":"21-29."},{"verse":7,"text":"Concludes with a joyful hope of deliverance, ver."},{"verse":8,"text":"30, 31 To the chief musician, A psalm of David."},{"verse":9,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":10,"text":"God - The author and matter of all my praises.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"4.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":12,"text":"Adversaries - They requite my love with enmity, as it is explained ver.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":13,"text":"5.","scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":14,"text":"6.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"A wicked man - Who will rule him with rigor and cruelty.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":16,"text":"Satan - To accuse him; for this was the place and posture of accusers in the Jewish courts.","scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":17,"text":"7.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":18,"text":"Sin - Because it is not from his heart.","scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":19,"text":"10.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":20,"text":"Desolate places - Into which they are fled for fear and shame.","scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":21,"text":"11.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":22,"text":"Catch - Hebrew. ensnare, take away not only by oppression but also by cunning artificers.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":23,"text":"Stranger - Who hath no right to his goods.","scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":24,"text":"17.","scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":25,"text":"Delighted not - In desiring and promoting the welfare of others.","scriptureVerseStart":17,"scriptureVerseEnd":17},{"verse":26,"text":"18.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":27,"text":"Garment - Which a man wears constantly.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":28,"text":"Like water - Water in the cavity of the belly, between the bowels, is almost certain death.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":29,"text":"And oil soaking into any of the bones, will soon utterly destroy it.","scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":30,"text":"20.","scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":31,"text":"That speak evil against my soul - With design to take away my life.","scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":32,"text":"21.","scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":33,"text":"Is good - Above the mercy of all the creatures.","scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":34,"text":"23.","scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":35,"text":"When - Towards the evening, when the sun is setting.","scriptureVerseStart":23,"scriptureVerseEnd":23},{"verse":36,"text":"The locust - Which is easily driven away with every wind.","scriptureVerseStart":23,"scriptureVerseEnd":23}],"scriptureReference":{"book":"Psalms","chapter":109}}