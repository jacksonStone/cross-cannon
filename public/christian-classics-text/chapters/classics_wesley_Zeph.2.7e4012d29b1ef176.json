{"author":"John Wesley","book":"Notes on the Bible","chapter":1167,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Zeph.2","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Zephaniah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Zephaniah 2","reference":"Zephaniah 2","notes":[],"verses":[{"verse":1,"text":"An exhortation to repentance, ver.","sourceParagraph":1},{"verse":2,"text":"1-3.","sourceParagraph":1},{"verse":3,"text":"A denunciation of the judgments of God against the Philistines, ver.","sourceParagraph":1},{"verse":4,"text":"4-7.","sourceParagraph":1},{"verse":5,"text":"The Moabites and Ammonites, ver.","sourceParagraph":1},{"verse":6,"text":"8-11.","sourceParagraph":1},{"verse":7,"text":"The Arabians and Assyrians, ver.","sourceParagraph":1},{"verse":8,"text":"12- 15.","sourceParagraph":1},{"verse":9,"text":"1.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":10,"text":"Gather yourselves - Call a solemn assembly, proclaim a fast.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":11,"text":"Not desired - Or, not desirous.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":12,"text":"Unwilling to return, and unworthy to be received on your return.","sourceParagraph":2,"scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":13,"text":"2.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":14,"text":"The decree - Before God's decree is put in execution.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":15,"text":"The day - Before the day of your calamities.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":16,"text":"As the chaff - Carry you away as the wind carries chaff away.","sourceParagraph":3,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":17,"text":"3.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":18,"text":"Seek - Fear, worship, depend on him alone.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":19,"text":"Ye meek - Ye humble ones.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":20,"text":"Wrought his judgment - Obeyed his precepts.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":21,"text":"Seek righteousness - Continue therein.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":22,"text":"Seek meekness - Patiently wait on the just and merciful God.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":23,"text":"Hid - Under the wing of Divine Providence.","sourceParagraph":4,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":24,"text":"4.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":25,"text":"For - It is time to seek God; for your neighbours, as well as you, shall be destroyed.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":26,"text":"Gaza - A chief city of the Philistines.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":27,"text":"They - The Babylonians.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":28,"text":"Shall drive - Into captivity.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":29,"text":"At the noon day - It shall be taken by force at noon.","sourceParagraph":5,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":30,"text":"5.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":31,"text":"The inhabitants - All the Philistines.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":32,"text":"Cherethites - Or destroyers, men that were stout, fierce, and terrible to their neighbours.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":33,"text":"O Canaan - That part that the Philistines kept by force from the Jews.","sourceParagraph":6,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":34,"text":"6.","sourceParagraph":7,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":35,"text":"For shepherds - Instead of cities full of rich citizens, there shall be only cottages for shepherds.","sourceParagraph":7,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":36,"text":"7.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":37,"text":"The coast - The sea-coast, the land of the Philistines.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":38,"text":"The remnant - That survive the captivity.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":39,"text":"Shall feed - Their flocks.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":40,"text":"In the houses - In places where these formerly stood.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":41,"text":"They - Both shepherds and flocks.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":42,"text":"Shall visit - In mercy.","sourceParagraph":8,"scriptureVerseStart":7,"scriptureVerseEnd":7},{"verse":43,"text":"8.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":44,"text":"I - God.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":45,"text":"Magnified themselves - Invading their frontiers.","sourceParagraph":9,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":46,"text":"9.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":47,"text":"Of nettles - Not cultivated, but over-run with nettles.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":48,"text":"Salt-pits - A dry, barren earth, fit only to dig salt out of.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":49,"text":"The residue - That return out of Babylon.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":50,"text":"Possess them - Settle upon those parts of their lands, that are fit for habitation.","sourceParagraph":10,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":51,"text":"11.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":52,"text":"Famish - Take away all their sacrifices and drink-offerings.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":53,"text":"The gods - Idols of those lands.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":54,"text":"From his place - Not only at Jerusalem, but everywhere.","sourceParagraph":11,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":55,"text":"12.","sourceParagraph":12,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":56,"text":"By my sword - The Chaldeans are called God's sword; because God employed them.","sourceParagraph":12,"scriptureVerseStart":12,"scriptureVerseEnd":12},{"verse":57,"text":"13.","sourceParagraph":13,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":58,"text":"He - God.","sourceParagraph":13,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":59,"text":"The north - Assyria, which lay northward of Judea, and due north from Babylon.","sourceParagraph":13,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":60,"text":"14.","sourceParagraph":14,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":61,"text":"All the beasts - All sorts of beasts which are found in those countries.","sourceParagraph":14,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":62,"text":"The bittern - A bird that delights in desolate places.","sourceParagraph":14,"scriptureVerseStart":14,"scriptureVerseEnd":14},{"verse":63,"text":"15.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":64,"text":"This - So the prophet triumphs over her.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":65,"text":"There is none - None like me, or that can contend with me.","sourceParagraph":15,"scriptureVerseStart":15,"scriptureVerseEnd":15}],"scriptureReference":{"book":"Zephaniah","chapter":2}}