{"author":"John Wesley","book":"Notes on the Bible","chapter":916,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Prov.29","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Proverbs","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Proverbs 29","reference":"Proverbs 29","notes":[],"verses":[{"verse":1,"text":"4.","sourceParagraph":1,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":2,"text":"Judgment - By the free and impartial exercise of justice.","sourceParagraph":1,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":3,"text":"Gifts - Bribes.","sourceParagraph":1,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":4,"text":"8.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":5,"text":"Wrath - The wrath of God or of men, who were enraged against it.","sourceParagraph":2,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":6,"text":"9.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":7,"text":"Whether - Whether he, the wise man, deal sharply with him, or mildly, there is no rest, no end or fruit of the debate.","sourceParagraph":3,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":8,"text":"10.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":9,"text":"Seek - To preserve it.","sourceParagraph":4,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":10,"text":"15.","sourceParagraph":5,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":11,"text":"Left - Suffered to follow his own will without restraint and chastening.","sourceParagraph":5,"scriptureVerseStart":15,"scriptureVerseEnd":15},{"verse":12,"text":"18.","sourceParagraph":6,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":13,"text":"No vision - No prophecy; no publick preaching of God's word.","sourceParagraph":6,"scriptureVerseStart":18,"scriptureVerseEnd":18},{"verse":14,"text":"19.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":15,"text":"A servant - Who is so not only in condition, but also in the temper of his mind, disingenuous, and stubborn.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":16,"text":"Words - By mere words.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":17,"text":"Tho' - Though he know thy mind, and his own duty.","sourceParagraph":7,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":18,"text":"20.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":19,"text":"Hasty - Who is rash and heady in the management of his affairs.","sourceParagraph":8,"scriptureVerseStart":20,"scriptureVerseEnd":20},{"verse":20,"text":"21.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":21,"text":"Delicately - Allowing him too much freedom, and familiarity.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":22,"text":"A son - Will find him at last grow insolent, and forgetful of his servile condition.","sourceParagraph":9,"scriptureVerseStart":21,"scriptureVerseEnd":21},{"verse":23,"text":"24.","sourceParagraph":10,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":24,"text":"Bewrayeth it not - Which he is bound to do for the publick good.","sourceParagraph":10,"scriptureVerseStart":24,"scriptureVerseEnd":24},{"verse":25,"text":"25.","sourceParagraph":11,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":26,"text":"A snare - Is an occasion of many sins.","sourceParagraph":11,"scriptureVerseStart":25,"scriptureVerseEnd":25},{"verse":27,"text":"26.","sourceParagraph":12,"scriptureVerseStart":26,"scriptureVerseEnd":26},{"verse":28,"text":"Judgment - The decision of his cause, and the success of all his endeavours.","sourceParagraph":12,"scriptureVerseStart":26,"scriptureVerseEnd":26}],"scriptureReference":{"book":"Proverbs","chapter":29}}