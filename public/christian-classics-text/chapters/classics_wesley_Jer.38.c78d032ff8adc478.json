{"author":"John Wesley","book":"Notes on the Bible","chapter":1042,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Jer.38","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Jeremiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Jeremiah 38","reference":"Jeremiah 38","notes":[],"verses":[{"verse":1,"text":"Jeremiah prophesies; is by the princes, with the king's permission, cast into a dungeon; but is by Ebed-melech, with the king's consent, taken out again, ver.","sourceParagraph":1},{"verse":2,"text":"1-13.","sourceParagraph":1},{"verse":3,"text":"He has a secret conference with the king, in which he counsels him by yielding, to save his life, ver.","sourceParagraph":1},{"verse":4,"text":"14-23.","sourceParagraph":1},{"verse":5,"text":"By the king's command he conceals the conference from the princes, ver.","sourceParagraph":1},{"verse":6,"text":"24-27.","sourceParagraph":1},{"verse":7,"text":"He abides in prison 'till Jerusalem is taken, ver.","sourceParagraph":1},{"verse":8,"text":"28.","sourceParagraph":1},{"verse":9,"text":"5.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":10,"text":"For the king - I see I am as it were no king.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":11,"text":"I can do nothing against you, you will do what you please.","sourceParagraph":2,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"10.","sourceParagraph":3,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":13,"text":"Thirty men - Probably the king commanded Ebed-melech to take thirty men to guard him against any opposition.","sourceParagraph":3,"scriptureVerseStart":10,"scriptureVerseEnd":10},{"verse":14,"text":"19.","sourceParagraph":4,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":15,"text":"Lest they - Lest the Chaldeans should deliver me into the hands of those Jews which have fallen to them.","sourceParagraph":4,"scriptureVerseStart":19,"scriptureVerseEnd":19},{"verse":16,"text":"22.","sourceParagraph":5,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":17,"text":"The women - Thou that art afraid of the insultings of men, shalt fall under the insultings of the women.","sourceParagraph":5,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":18,"text":"Thy friends - For this thou mayest thank thy priests, and false prophets.","sourceParagraph":5,"scriptureVerseStart":22,"scriptureVerseEnd":22},{"verse":19,"text":"And they - Have forsaken thee, every one shifting for himself.","sourceParagraph":5,"scriptureVerseStart":22,"scriptureVerseEnd":22}],"scriptureReference":{"book":"Jeremiah","chapter":38}}