{"author":"John Wesley","book":"Notes on the Bible","chapter":1028,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Jer.24","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Jeremiah","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Jeremiah 24","reference":"Jeremiah 24","notes":[],"verses":[{"verse":1,"text":"Under the type of good and bad figs, ver."},{"verse":2,"text":"1-3."},{"verse":3,"text":"He fore- shews the return of some from captivity, ver."},{"verse":4,"text":"4-7. and the ruin of Zedekiah and the rest, ver."},{"verse":5,"text":"8-10."},{"verse":6,"text":"1.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":7,"text":"And behold - Probably a vision.","scriptureVerseStart":1,"scriptureVerseEnd":1},{"verse":8,"text":"5.","scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":9,"text":"Acknowledge - I will acknowledge them for their good; I will shew them favour, being of the number of those who were not leaders to sin, but led away by the ill example of others, and who being carried away grew sensible of their sins, and so accepted of the punishment of their iniquities.","scriptureVerseStart":5,"scriptureVerseEnd":5}],"scriptureReference":{"book":"Jeremiah","chapter":24}}