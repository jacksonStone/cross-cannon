{"author":"John Wesley","book":"Notes on the Bible","chapter":880,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.143","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 143","reference":"Psalms 143","notes":[],"verses":[{"verse":1,"text":"David complains and prays for pardon and help, ver.","sourceParagraph":1},{"verse":2,"text":"1-12.","sourceParagraph":1},{"verse":3,"text":"A psalm of David.","sourceParagraph":1},{"verse":4,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":5,"text":"Justified - Upon terms of strict justice.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":6,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":7,"text":"For - This is not a reason of what he last said, but an argument to enforce his petition delivered, ver.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":8,"text":"1.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":9,"text":"Soul - My life; nothing less will satisfy him.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":10,"text":"Dead - I am in as hopeless a condition in the eye of man, as those that have lain long in the grave.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":11,"text":"5.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":12,"text":"The days - What thou hast done for thy servants in former times.","sourceParagraph":4,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":13,"text":"6.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":14,"text":"As land - Thirsteth for rain.","sourceParagraph":5,"scriptureVerseStart":6,"scriptureVerseEnd":6},{"verse":15,"text":"8.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8},{"verse":16,"text":"Morning - Seasonably and speedily.","sourceParagraph":6,"scriptureVerseStart":8,"scriptureVerseEnd":8}],"scriptureReference":{"book":"Psalms","chapter":143}}