{"author":"John Wesley","book":"Notes on the Bible","chapter":764,"classification":{"bucket":"Christian Classics / Commentaries","canonicalStatus":"noncanonical","contentKind":"commentary","cautionReason":"","doctrinalStatus":"historical","labels":["christian-classics","commentaries"],"severity":0},"id":"classics:wesley:Ps.27","lineage":[],"metadata":{"author":"John Wesley","authorshipDateRange":"18th century","genre":"Commentaries","tradition":"Methodist","translator":null,"edition":"CCEL edition; source omits 2 Samuel 24","rights":"Public Domain","source":{"id":"wesley","provider":"CCEL","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"}},"originalBook":"Psalms","sourceVolumeId":"wesley","source":{"id":"wesley","sourceUrl":"https://www.ccel.org/ccel/wesley/notes.html","title":"Notes on the Bible"},"title":"Psalms 27","reference":"Psalms 27","notes":[],"verses":[{"verse":1,"text":"David declares his confidence in God, ver.","sourceParagraph":1},{"verse":2,"text":"1-3.","sourceParagraph":1},{"verse":3,"text":"His desire to be in the house of God, ver.","sourceParagraph":1},{"verse":4,"text":"4-6.","sourceParagraph":1},{"verse":5,"text":"He prays for light and salvation, ver.","sourceParagraph":1},{"verse":6,"text":"7-12.","sourceParagraph":1},{"verse":7,"text":"And exhorts others to wait upon God, ver.","sourceParagraph":1},{"verse":8,"text":"13, 14.","sourceParagraph":1},{"verse":9,"text":"A psalm of David.","sourceParagraph":1},{"verse":10,"text":"2.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":11,"text":"Light - My counsellor in all my difficulties, and my comforter and deliverer in all my distresses.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":12,"text":"Strength - The supporter and preserver of my life.","sourceParagraph":2,"scriptureVerseStart":2,"scriptureVerseEnd":2},{"verse":13,"text":"3.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":14,"text":"In this - That God is my light.","sourceParagraph":3,"scriptureVerseStart":3,"scriptureVerseEnd":3},{"verse":15,"text":"4.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":16,"text":"Dwell. &c. - Have opportunity of constant attendance upon God.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":17,"text":"To behold - That there I may delight myself, in the contemplation of thy amiable and glorious majesty, and of thy infinite wisdom, holiness, justice, truth, and mercy.","sourceParagraph":4,"scriptureVerseStart":4,"scriptureVerseEnd":4},{"verse":18,"text":"5.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":19,"text":"The secret - In his tabernacle, into which mine enemies cannot come.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":20,"text":"He alludes to the ancient custom of offenders, who used to flee to the tabernacle or altar.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":21,"text":"Rock - A place high and inaccessible.","sourceParagraph":5,"scriptureVerseStart":5,"scriptureVerseEnd":5},{"verse":22,"text":"9.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":23,"text":"Away - From thy face or presence, or from the place of thy worship.","sourceParagraph":6,"scriptureVerseStart":9,"scriptureVerseEnd":9},{"verse":24,"text":"11.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":25,"text":"Because of - That I may neither fall into their hands by my folly, nor give them any occasion of triumphing over me.","sourceParagraph":7,"scriptureVerseStart":11,"scriptureVerseEnd":11},{"verse":26,"text":"13.","sourceParagraph":8,"scriptureVerseStart":13,"scriptureVerseEnd":13},{"verse":27,"text":"The living - David was thus earnestly desirous of this mercy in this life, not because he placed his portion in these things; but because the truth and glory of God, were highly concerned in making good the promise of the kingdom to him.","sourceParagraph":8,"scriptureVerseStart":13,"scriptureVerseEnd":13}],"scriptureReference":{"book":"Psalms","chapter":27}}